			"definicion": "CREATE OR REPLACE FUNCTION public.auditoria_resumen(p_desde date DEFAULT NULL::date, p_hasta date DEFAULT NULL::date, p_usuario uuid DEFAULT NULL::uuid, p_sin_usuario boolean DEFAULT false, p_tablas text[] DEFAULT NULL::text[], p_acciones text[] DEFAULT NULL::text[], p_texto text DEFAULT NULL::text, p_monto_min numeric DEFAULT NULL::numeric, p_monto_max numeric DEFAULT NULL::numeric, p_campos text[] DEFAULT NULL::text[])\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\ndeclare r jsonb;\nbegin\n  if coalesce(public.pms_rol(), '') not in ('gerencia','sysadmin') then\n    raise exception 'Solo Gerencia o SysAdmin pueden ver la auditoría';\n  end if;\n  with f as (\n    select * from public._aud_filtrada(p_desde, p_hasta, p_usuario, p_sin_usuario, p_tablas, p_acciones,\n                                       p_texto, p_monto_min, p_monto_max, p_campos))\n  select jsonb_build_object(\n    'total',           (select count(*) from f),\n    'crear',           (select count(*) from f where accion = 'INSERT'),\n    'modificar',       (select count(*) from f where accion = 'UPDATE'),\n    'eliminar',        (select count(*) from f where accion = 'DELETE'),\n    'usuarios',        (select count(distinct usuario_id) from f),\n    'pagos_n',         (select count(*) from f where tabla = 'pagos' and accion = 'INSERT'),\n    'pagos_monto',     (select coalesce(sum(monto), 0) from f where tabla = 'pagos' and accion = 'INSERT'),\n    'pagos_alterados', (select count(*) from f where tabla = 'pagos' and accion in ('UPDATE','DELETE')),\n    'top_usuarios',    (select coalesce(jsonb_agg(to_jsonb(x) order by x.n desc), '[]'::jsonb)\n                          from (select usuario_id, coalesce(usuario_nombre, 'Sistema / SQL') as nombre, count(*) as n\n                                  from f group by 1, 2 order by n desc limit 6) x)\n  ) into r;\n  return r;\nend $function$\n",
