		{
			"nombre": "eliminar_usuario_completo",
			"esquema": "public",
			"retorno": "void",
			"lenguaje": "plpgsql",
			"argumentos": "p_usuario_id uuid",
			"definicion": "CREATE OR REPLACE FUNCTION public.eliminar_usuario_completo(p_usuario_id uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'auth'\nAS $function$\nDECLARE\n  v_actor uuid := auth.uid();\n  v_actor_rol text;\n  v_target_rol text;\nBEGIN\n  IF v_actor IS NULL THEN\n    RAISE EXCEPTION 'Sesión no válida';\n  END IF;\n\n  SELECT rol::text\n  INTO v_actor_rol\n  FROM public.perfiles\n  WHERE id = v_actor\n    AND activo = true;\n\n  IF v_actor_rol NOT IN ('gerencia', 'sysadmin') THEN\n    RAISE EXCEPTION 'No tienes permiso para eliminar usuarios';\n  END IF;\n\n  IF p_usuario_id IS NULL THEN\n    RAISE EXCEPTION 'Usuario no especificado';\n  END IF;\n\n  IF p_usuario_id = v_actor THEN\n    RAISE EXCEPTION 'No puedes eliminar tu propio usuario';\n  END IF;\n\n  SELECT rol::text\n  INTO v_target_rol\n  FROM public.perfiles\n  WHERE id = p_usuario_id;\n\n  IF v_target_rol IS NULL THEN\n    RAISE EXCEPTION 'Usuario no encontrado';\n  END IF;\n\n  IF v_target_rol = 'sysadmin' AND v_actor_rol <> 'sysadmin' THEN\n    RAISE EXCEPTION 'Solo un SysAdmin puede eliminar a otro SysAdmin';\n  END IF;\n\n  UPDATE public.configuracion\n  SET actualizado_por = NULL\n  WHERE actualizado_por = p_usuario_id;\n\n  UPDATE public.huespedes\n  SET creado_por = NULL\n  WHERE creado_por = p_usuario_id;\n\n  UPDATE public.lista_negra\n  SET agregado_por = NULL\n  WHERE agregado_por = p_usuario_id;\n\n  UPDATE public.reservas\n  SET creado_por = NULL,\n      cancelada_por = NULL\n  WHERE creado_por = p_usuario_id\n     OR cancelada_por = p_usuario_id;\n\n  UPDATE public.notas_huesped\n  SET creado_por = NULL\n  WHERE creado_por = p_usuario_id;\n\n  UPDATE public.cargos\n  SET creado_por = NULL\n  WHERE creado_por = p_usuario_id;\n\n  UPDATE public.pagos\n  SET creado_por = NULL\n  WHERE creado_por = p_usuario_id;\n\n  UPDATE public.limpieza\n  SET asignado_a = NULL,\n      actualizado_por = NULL\n  WHERE asignado_a = p_usuario_id\n     OR actualizado_por = p_usuario_id;\n\n  UPDATE public.lista_negra_solicitudes\n  SET solicitado_por = NULL,\n      revisado_por = NULL\n  WHERE solicitado_por = p_usuario_id\n     OR revisado_por = p_usuario_id;\n\n  UPDATE public.reclamos_sugerencias\n  SET creado_por = NULL\n  WHERE creado_por = p_usuario_id;\n\n  DELETE FROM public.perfiles_edificios\n  WHERE perfil_id = p_usuario_id;\n\n  DELETE FROM public.perfiles_permisos_edicion\n  WHERE perfil_id = p_usuario_id;\n\n  DELETE FROM public.perfiles\n  WHERE id = p_usuario_id;\n\n  IF NOT FOUND THEN\n    RAISE EXCEPTION 'No se pudo eliminar el perfil del usuario';\n  END IF;\n\n  DELETE FROM auth.users\n  WHERE id = p_usuario_id;\n\n  IF NOT FOUND THEN\n    RAISE EXCEPTION 'El perfil fue eliminado, pero no se encontró la cuenta de autenticación';\n  END IF;\nEND;\n$function$\n",
