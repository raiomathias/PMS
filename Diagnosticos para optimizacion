			"definicion": "CREATE OR REPLACE FUNCTION public.validar_cupo_estacionamiento()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\ndeclare\r\n  v_edificio uuid;\r\n  v_cupos int;\r\n  v_max_ocupados int;\r\nbegin\r\n  if not new.usa_estacionamiento\r\n     or new.estado not in ('tentativa','confirmada','en_casa') then\r\n    return new;\r\n  end if;\r\n\r\n  select e.id, e.cupos_estacionamiento into v_edificio, v_cupos\r\n  from unidades u join edificios e on e.id = u.edificio_id\r\n  where u.id = new.unidad_id;\r\n\r\n  if v_cupos = 0 then\r\n    raise exception 'Este edificio no tiene estacionamiento';\r\n  end if;\r\n\r\n  select coalesce(max(t.ocupados), 0) into v_max_ocupados\r\n  from (\r\n    select d::date as noche, count(r.id) as ocupados\r\n    from generate_series(new.fecha_entrada::timestamp,\r\n                         (new.fecha_salida - 1)::timestamp,\r\n                         interval '1 day') d\r\n    left join reservas r\r\n      on r.usa_estacionamiento\r\n     and r.estado in ('tentativa','confirmada','en_casa')\r\n     and r.id <> new.id\r\n     and d::date >= r.fecha_entrada\r\n     and d::date <  r.fecha_salida\r\n     and r.unidad_id in (select id from unidades where edificio_id = v_edificio)\r\n    group by d\r\n  ) t;\r\n\r\n  if v_max_ocupados >= v_cupos then\r\n    raise exception 'Sin cupos de estacionamiento para esas fechas';\r\n  end if;\r\n  return new;\r\nend $function$\n",
