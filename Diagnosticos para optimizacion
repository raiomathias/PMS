			"retorno": "uuid",
			"lenguaje": "plpgsql",
			"argumentos": "p_reserva_id uuid, p_metodo text, p_moneda text, p_monto_original numeric, p_tipo_cambio numeric, p_monto_clp integer, p_anticipado boolean, p_motivo_principal text, p_id_transaccion text, p_motivos jsonb",
			"definicion": "CREATE OR REPLACE FUNCTION public.registrar_pago_completo(p_reserva_id uuid, p_metodo text, p_moneda text, p_monto_original numeric, p_tipo_cambio numeric, p_monto_clp integer, p_anticipado boolean, p_motivo_principal text, p_id_transaccion text, p_motivos jsonb)\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\nDECLARE\n  v_pago_id uuid;\n\n  v_sum_original numeric := 0;\n  v_sum_clp integer := 0;\n\n  v_item jsonb;\n  v_motivo text;\n  v_orig numeric;\n  v_clp integer;\n\n  v_metodo_type regtype;\nBEGIN\n\n  -- ==========================================================\n  -- VALIDACIÓN DE SESIÓN\n  -- ==========================================================\n\n  IF auth.uid() IS NULL THEN\n    RAISE EXCEPTION 'Sesión no válida';\n  END IF;\n\n\n  -- ==========================================================\n  -- VALIDACIÓN DE RESERVA\n  -- ==========================================================\n\n  IF NOT EXISTS (\n    SELECT 1\n    FROM public.reservas\n    WHERE id = p_reserva_id\n  ) THEN\n    RAISE EXCEPTION 'Reserva no encontrada';\n  END IF;\n\n\n  -- ==========================================================\n  -- VALIDACIÓN DEL MONTO\n  -- ==========================================================\n\n  IF p_monto_original IS NULL\n     OR p_monto_original <= 0\n     OR p_monto_clp IS NULL\n     OR p_monto_clp <= 0\n  THEN\n    RAISE EXCEPTION 'El monto del pago debe ser mayor que cero';\n  END IF;\n\n\n  -- ==========================================================\n  -- VALIDACIÓN DEL MOTIVO PRINCIPAL\n  -- ==========================================================\n\n  IF p_motivo_principal NOT IN (\n    'estadia',\n    'estacionamiento',\n    'horario_extra',\n    'penalizacion',\n    'consumos',\n    'garantia',\n    'otro'\n  ) THEN\n    RAISE EXCEPTION 'Motivo de pago no válido';\n  END IF;\n\n\n  -- ==========================================================\n  -- VALIDACIÓN DEL ARRAY DE MOTIVOS\n  -- ==========================================================\n\n  IF p_motivos IS NULL\n     OR jsonb_typeof(p_motivos) <> 'array'\n     OR jsonb_array_length(p_motivos) = 0\n  THEN\n    RAISE EXCEPTION 'El pago debe tener al menos un motivo';\n  END IF;\n\n\n  -- ==========================================================\n  -- VALIDAR Y SUMAR MOTIVOS\n  -- ==========================================================\n\n  FOR v_item IN\n    SELECT value\n    FROM jsonb_array_elements(p_motivos)\n  LOOP\n\n    v_motivo := v_item->>'motivo';\n\n    v_orig :=\n      (v_item->>'monto_original')::numeric;\n\n    v_clp :=\n      (v_item->>'monto_clp')::integer;\n\n\n    IF v_motivo NOT IN (\n      'estadia',\n      'estacionamiento',\n      'horario_extra',\n      'penalizacion',\n      'consumos',\n      'garantia',\n      'otro'\n    ) THEN\n      RAISE EXCEPTION\n        'Motivo de pago no válido: %',\n        v_motivo;\n    END IF;\n\n\n    IF v_orig IS NULL\n       OR v_orig <= 0\n       OR v_clp IS NULL\n       OR v_clp <= 0\n    THEN\n      RAISE EXCEPTION\n        'Todos los motivos deben tener un monto mayor que cero';\n    END IF;\n\n\n    v_sum_original :=\n      v_sum_original + v_orig;\n\n    v_sum_clp :=\n      v_sum_clp + v_clp;\n\n  END LOOP;\n\n\n  -- ==========================================================\n  -- LOS MOTIVOS DEBEN SUMAR EL PAGO\n  -- ==========================================================\n\n  IF abs(\n    v_sum_original - p_monto_original\n  ) > 0.005\n  THEN\n    RAISE EXCEPTION\n      'Los motivos no coinciden con el monto total del pago';\n  END IF;\n\n\n  IF abs(\n    v_sum_clp - p_monto_clp\n  ) > 1\n  THEN\n    RAISE EXCEPTION\n      'Los motivos en CLP no coinciden con el monto total del pago';\n  END IF;\n\n\n  -- ==========================================================\n  -- OBTENER TIPO REAL DE LA COLUMNA metodo\n  --\n  -- No asumimos el nombre del ENUM existente.\n  -- ==========================================================\n\n  SELECT a.atttypid::regtype\n  INTO v_metodo_type\n  FROM pg_attribute a\n  WHERE a.attrelid = 'public.pagos'::regclass\n    AND a.attname = 'metodo'\n    AND NOT a.attisdropped;\n\n\n  IF v_metodo_type IS NULL THEN\n    RAISE EXCEPTION\n      'No se pudo determinar el tipo de método de pago';\n  END IF;\n\n\n  -- ==========================================================\n  -- CREAR PAGO\n  --\n  -- SECURITY DEFINER permite que esta operación se realice\n  -- de forma controlada sin exponer INSERT directo sobre\n  -- pagos_motivos al cliente.\n  -- ==========================================================\n\n  EXECUTE format(\n    '\n    INSERT INTO public.pagos(\n      reserva_id,\n      metodo,\n      moneda,\n      monto_original,\n      tipo_cambio,\n      monto_clp,\n      anticipado,\n      motivo,\n      id_transaccion,\n      creado_por\n    )\n    VALUES (\n      $1,\n      $2::%s,\n      $3::bpchar,\n      $4,\n      $5,\n      $6,\n      $7,\n      $8,\n      $9,\n      $10\n    )\n    RETURNING id\n    ',\n    v_metodo_type\n  )\n  USING\n    p_reserva_id,\n    p_metodo,\n    p_moneda,\n    p_monto_original,\n    p_tipo_cambio,\n    p_monto_clp,\n    COALESCE(p_anticipado, false),\n    p_motivo_principal,\n    NULLIF(\n      trim(p_id_transaccion),\n      ''\n    ),\n    auth.uid()\n  INTO v_pago_id;\n\n\n  -- ==========================================================\n  -- CREAR TODOS LOS MOTIVOS DEL PAGO\n  -- ==========================================================\n\n  FOR v_item IN\n    SELECT value\n    FROM jsonb_array_elements(p_motivos)\n  LOOP\n\n    INSERT INTO public.pagos_motivos(\n      pago_id,\n      motivo,\n      monto_original,\n      monto_clp\n    )\n    VALUES (\n      v_pago_id,\n      v_item->>'motivo',\n      (v_item->>'monto_original')::numeric,\n      (v_item->>'monto_clp')::integer\n    );\n\n  END LOOP;\n\n\n  -- ==========================================================\n  -- DEVOLVER ID DEL PAGO\n  -- ==========================================================\n\n  RETURN v_pago_id;\n\nEND;\n$function$\n",
			"propietario": "postgres",
			"volatilidad": "volatil",
