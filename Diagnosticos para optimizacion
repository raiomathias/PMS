			"definicion": "CREATE OR REPLACE FUNCTION public.marcar_no_show(p_reserva_id uuid, p_nota text DEFAULT NULL::text)\n RETURNS integer\n LANGUAGE plpgsql\nAS $function$\r\ndeclare\r\n  r reservas%rowtype;\r\n  v_noches_cobro int := (select valor::int from configuracion where clave = 'cancelacion_noches_cobradas');\r\n  v_cargo int;\r\nbegin\r\n  select * into r from reservas where id = p_reserva_id for update;\r\n  if not found then raise exception 'Reserva no encontrada'; end if;\r\n  if r.estado not in ('tentativa','confirmada') then\r\n    raise exception 'Solo se puede marcar no-show en reservas tentativas o confirmadas';\r\n  end if;\r\n  if r.fecha_entrada > (now() at time zone 'America/Santiago')::date then\r\n    raise exception 'La reserva aún no llega a su fecha de entrada';\r\n  end if;\r\n\r\n  v_cargo := r.tarifa_noche * coalesce(v_noches_cobro, 1);\r\n  insert into cargos (reserva_id, tipo, descripcion, cantidad, monto_unitario, creado_por)\r\n  values (r.id, 'no_show', 'No-show: el huésped no llegó', 1, v_cargo, auth.uid());\r\n\r\n  update reservas\r\n     set estado = 'no_show', no_show_en = now(), no_show_por = auth.uid(),\r\n         no_show_nota = nullif(trim(coalesce(p_nota,'')), '')\r\n   where id = r.id;\r\n\r\n  insert into notas_huesped (huesped_id, reserva_id, nota, categoria, gravedad, creado_por)\r\n  values (r.huesped_id, r.id,\r\n          'No-show en la reserva ' || r.uid_reserva || ' (entrada ' || r.fecha_entrada || ')',\r\n          'no_show', 2, auth.uid());\r\n\r\n  return v_cargo;\r\nend $function$\n",
