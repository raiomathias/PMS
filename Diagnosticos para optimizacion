			"definicion": "CREATE OR REPLACE FUNCTION public.pms_buscar_reacomodacion(p_edificio_id uuid, p_tipo_unidad_id uuid, p_entrada date, p_salida date, p_excluir_reserva uuid DEFAULT NULL::uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\nDECLARE\n    v_directa uuid;\n    v_target record;\n    v_plan jsonb;\nBEGIN\n    IF p_salida <= p_entrada THEN\n        RETURN jsonb_build_object(\n            'unidad_id', NULL,\n            'plan', '[]'::jsonb,\n            'motivo', 'Rango de fechas inválido'\n        );\n    END IF;\n\n    -- 1. Unidad directamente libre de la categoría solicitada.\n    SELECT u.id\n    INTO v_directa\n    FROM public.unidades u\n    WHERE u.activo\n      AND u.edificio_id = p_edificio_id\n      AND u.tipo_unidad_id = p_tipo_unidad_id\n      AND NOT EXISTS (\n          SELECT 1\n          FROM public.reservas r\n          WHERE r.unidad_id = u.id\n            AND r.id IS DISTINCT FROM p_excluir_reserva\n            AND r.fecha_entrada < p_salida\n            AND r.fecha_salida > p_entrada\n            AND r.estado IN ('tentativa','confirmada','en_casa','bloqueado')\n      )\n    ORDER BY u.orden, u.codigo\n    LIMIT 1;\n\n    IF v_directa IS NOT NULL THEN\n        RETURN jsonb_build_object(\n            'unidad_id', v_directa,\n            'plan', '[]'::jsonb,\n            'upgrade', false\n        );\n    END IF;\n\n    -- 2. Buscar unidades objetivo que tengan exactamente una reserva\n    --    bloqueándolas. Esa reserva será el primer eslabón de la cadena.\n    FOR v_target IN\n        SELECT\n            u.id AS target_unit,\n            r.id AS blocker_id,\n            r.fecha_entrada AS blocker_entrada,\n            r.fecha_salida AS blocker_salida\n        FROM public.unidades u\n        JOIN public.reservas r\n          ON r.unidad_id = u.id\n         AND r.id IS DISTINCT FROM p_excluir_reserva\n         AND r.fecha_entrada < p_salida\n         AND r.fecha_salida > p_entrada\n         AND r.estado IN ('tentativa','confirmada','bloqueado')\n        WHERE u.activo\n          AND u.edificio_id = p_edificio_id\n          AND u.tipo_unidad_id = p_tipo_unidad_id\n          AND (\n              SELECT count(*)\n              FROM public.reservas rx\n              WHERE rx.unidad_id = u.id\n                AND rx.id IS DISTINCT FROM p_excluir_reserva\n                AND rx.fecha_entrada < p_salida\n                AND rx.fecha_salida > p_entrada\n                AND rx.estado IN ('tentativa','confirmada','en_casa','bloqueado')\n          ) = 1\n        ORDER BY\n            (r.fecha_salida - r.fecha_entrada) ASC,\n            u.orden,\n            u.codigo\n    LOOP\n        -- La reserva inicial jamás puede ser en_casa.\n        IF EXISTS (\n            SELECT 1\n            FROM public.reservas r0\n            WHERE r0.id = v_target.blocker_id\n              AND r0.estado = 'en_casa'\n        ) THEN\n            CONTINUE;\n        END IF;\n\n        /*\n         * CTE recursiva.\n         * Cada fila representa una reserva que necesitamos mover.\n         * to_uid es el destino de esa reserva.\n         * blocker_next es la reserva que bloquea dicho destino,\n         * si existe exactamente una.\n         */\n        WITH RECURSIVE chain AS (\n            SELECT\n                v_target.blocker_id AS reserva_id,\n                r0.unidad_id AS unidad_origen,\n                c.id AS unidad_destino,\n                r0.fecha_entrada,\n                r0.fecha_salida,\n                1 AS profundidad,\n                ARRAY[v_target.blocker_id]::uuid[] AS reservas_vistas,\n                ARRAY[v_target.target_unit, c.id]::uuid[] AS unidades_vistas,\n                EXISTS (\n                    SELECT 1\n                    FROM public.categoria_ranking_edificio cr0\n                    JOIN public.unidades uu0 ON uu0.id = r0.unidad_id\n                    JOIN public.categoria_ranking_edificio cr1\n                      ON cr1.edificio_id = c.edificio_id\n                     AND cr1.tipo_unidad_id = c.tipo_unidad_id\n                    WHERE cr0.edificio_id = uu0.edificio_id\n                      AND cr0.tipo_unidad_id = uu0.tipo_unidad_id\n                      AND cr1.ranking > cr0.ranking\n                ) AS upgrade\n            FROM public.reservas r0\n            JOIN public.unidades src\n              ON src.id = r0.unidad_id\n            JOIN public.unidades c\n              ON c.activo\n             AND c.edificio_id = src.edificio_id\n             AND c.id <> r0.unidad_id\n            LEFT JOIN public.categoria_ranking_edificio src_rank\n              ON src_rank.edificio_id = src.edificio_id\n             AND src_rank.tipo_unidad_id = src.tipo_unidad_id\n            LEFT JOIN public.categoria_ranking_edificio dst_rank\n              ON dst_rank.edificio_id = c.edificio_id\n             AND dst_rank.tipo_unidad_id = c.tipo_unidad_id\n            WHERE r0.id = v_target.blocker_id\n              AND (\n                  c.tipo_unidad_id = src.tipo_unidad_id\n                  OR COALESCE(dst_rank.ranking,0) > COALESCE(src_rank.ranking,0)\n              )\n              AND c.id <> v_target.target_unit\n              AND NOT EXISTS (\n                  SELECT 1\n                  FROM public.reservas b\n                  WHERE b.unidad_id = c.id\n                    AND b.id IS DISTINCT FROM p_excluir_reserva\n                    AND b.fecha_entrada < r0.fecha_salida\n                    AND b.fecha_salida > r0.fecha_entrada\n                    AND b.estado IN ('en_casa','tentativa','confirmada','bloqueado')\n                    AND b.estado = 'en_casa'\n              )\n              AND NOT EXISTS (\n                  SELECT 1\n                  FROM public.reservas b\n                  WHERE b.unidad_id = c.id\n                    AND b.id IS DISTINCT FROM p_excluir_reserva\n                    AND b.fecha_entrada < r0.fecha_salida\n                    AND b.fecha_salida > r0.fecha_entrada\n                    AND b.estado IN ('en_casa','tentativa','confirmada','bloqueado')\n                  HAVING count(*) > 1\n              )\n\n            UNION ALL\n\n            SELECT\n                b.id AS reserva_id,\n                cur.unidad_destino AS unidad_origen,\n                c.id AS unidad_destino,\n                b.fecha_entrada,\n                b.fecha_salida,\n                cur.profundidad + 1,\n                cur.reservas_vistas || b.id,\n                cur.unidades_vistas || c.id,\n                cur.upgrade OR (\n                    c.tipo_unidad_id <> src.tipo_unidad_id\n                    AND COALESCE(dst_rank.ranking,0) > COALESCE(src_rank.ranking,0)\n                )\n            FROM chain cur\n            JOIN public.reservas b\n              ON b.id = (\n                  SELECT bx.id\n                  FROM public.reservas bx\n                  WHERE bx.unidad_id = cur.unidad_destino\n                    AND bx.id IS DISTINCT FROM p_excluir_reserva\n                    AND bx.fecha_entrada < cur.fecha_salida\n                    AND bx.fecha_salida > cur.fecha_entrada\n                    AND bx.estado IN ('tentativa','confirmada','en_casa','bloqueado')\n                  LIMIT 1\n              )\n            JOIN public.unidades src\n              ON src.id = b.unidad_id\n            JOIN public.unidades c\n              ON c.activo\n             AND c.edificio_id = src.edificio_id\n             AND c.id <> b.unidad_id\n            LEFT JOIN public.categoria_ranking_edificio src_rank\n              ON src_rank.edificio_id = src.edificio_id\n             AND src_rank.tipo_unidad_id = src.tipo_unidad_id\n            LEFT JOIN public.categoria_ranking_edificio dst_rank\n              ON dst_rank.edificio_id = c.edificio_id\n             AND dst_rank.tipo_unidad_id = c.tipo_unidad_id\n            WHERE cur.profundidad < 6\n              AND b.estado <> 'en_casa'\n              AND b.id <> ALL(cur.reservas_vistas)\n              AND c.id <> ALL(cur.unidades_vistas)\n              AND (\n                  c.tipo_unidad_id = src.tipo_unidad_id\n                  OR COALESCE(dst_rank.ranking,0) > COALESCE(src_rank.ranking,0)\n              )\n        ),\n        terminals AS (\n            SELECT ch.*\n            FROM chain ch\n            WHERE NOT EXISTS (\n                SELECT 1\n                FROM public.reservas b\n                WHERE b.unidad_id = ch.unidad_destino\n                  AND b.id IS DISTINCT FROM p_excluir_reserva\n                  AND b.fecha_entrada < ch.fecha_salida\n                  AND b.fecha_salida > ch.fecha_entrada\n                  AND b.estado IN ('en_casa','tentativa','confirmada','bloqueado')\n            )\n        )\n        SELECT jsonb_agg(\n            jsonb_build_object(\n                'reserva_id', reserva_id,\n                'unidad_origen', unidad_origen,\n                'unidad_destino', unidad_destino,\n                'fecha_entrada', fecha_entrada,\n                'fecha_salida', fecha_salida,\n                'profundidad', profundidad,\n                'upgrade', upgrade\n            )\n            ORDER BY profundidad DESC\n        )\n        INTO v_plan\n        FROM terminals;\n\n        IF v_plan IS NOT NULL THEN\n            RETURN jsonb_build_object(\n                'unidad_id', v_target.target_unit,\n                'plan', v_plan,\n                'upgrade', EXISTS (\n                    SELECT 1\n                    FROM jsonb_array_elements(v_plan) x\n                    WHERE COALESCE((x->>'upgrade')::boolean,false)\n                )\n            );\n        END IF;\n    END LOOP;\n\n    RETURN jsonb_build_object(\n        'unidad_id', NULL,\n        'plan', '[]'::jsonb,\n        'upgrade', false,\n        'motivo', 'No existe una reacomodación segura'\n    );\nEND;\n$function$\n",
			"propietario": "postgres",
			"volatilidad": "estable",
