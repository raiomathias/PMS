			"definicion": "CREATE OR REPLACE FUNCTION public._aud_filtrada(p_desde date, p_hasta date, p_usuario uuid, p_sin_usuario boolean, p_tablas text[], p_acciones text[], p_texto text, p_monto_min numeric, p_monto_max numeric, p_campos text[])\n RETURNS TABLE(id bigint, tabla text, registro_id uuid, accion text, datos_anteriores jsonb, datos_nuevos jsonb, usuario_id uuid, usuario_nombre text, usuario_rol text, fecha timestamp with time zone, reserva_id uuid, reserva_uid text, huesped text, monto numeric)\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  with base as (\n    select a.id, a.tabla, a.registro_id, a.accion, a.datos_anteriores, a.datos_nuevos, a.usuario_id,\n           pf.nombre_completo as usuario_nombre, pf.rol::text as usuario_rol,\n           a.fecha::timestamptz as fecha,\n           case when a.tabla = 'reservas' then a.registro_id\n                else nullif(coalesce(a.datos_nuevos->>'reserva_id', a.datos_anteriores->>'reserva_id'), '')::uuid\n           end as reserva_id,\n           case when a.tabla in ('pagos','cargos') then\n                coalesce(nullif(a.datos_nuevos->>'monto_clp',''), nullif(a.datos_anteriores->>'monto_clp',''),\n                         nullif(a.datos_nuevos->>'total',''),     nullif(a.datos_anteriores->>'total',''))::numeric\n           end as monto\n      from public.auditoria a\n      left join public.perfiles pf on pf.id = a.usuario_id\n     where (p_desde is null or a.fecha::timestamptz >= (p_desde::timestamp at time zone 'America/Santiago'))\n       and (p_hasta is null or a.fecha::timestamptz <  ((p_hasta + 1)::timestamp at time zone 'America/Santiago'))\n       and (p_usuario is null or a.usuario_id = p_usuario)\n       and (not coalesce(p_sin_usuario, false) or a.usuario_id is null)\n       and (p_tablas is null or cardinality(p_tablas) = 0 or a.tabla = any (p_tablas))\n       and (p_acciones is null or cardinality(p_acciones) = 0 or a.accion = any (p_acciones))\n       and (p_campos is null or cardinality(p_campos) = 0\n            or (a.accion = 'UPDATE' and exists (select 1 from unnest(p_campos) c\n                 where a.datos_nuevos -> c is distinct from a.datos_anteriores -> c)))\n  )\n  select b.id, b.tabla, b.registro_id, b.accion, b.datos_anteriores, b.datos_nuevos, b.usuario_id,\n         b.usuario_nombre, b.usuario_rol, b.fecha, b.reserva_id, r.uid_reserva,\n         coalesce(r.huesped_nombre_copia, ''), b.monto\n    from base b\n    left join public.reservas r on r.id = b.reserva_id\n   where (p_monto_min is null or b.monto >= p_monto_min)\n     and (p_monto_max is null or b.monto <= p_monto_max)\n     and (p_texto is null or btrim(p_texto) = '' or not exists (\n           select 1 from unnest(string_to_array(lower(btrim(p_texto)), ' ')) w\n            where w <> '' and lower(concat_ws(' ', b.tabla, b.accion, b.usuario_nombre, r.uid_reserva,\n                  r.huesped_nombre_copia, b.registro_id::text, b.datos_anteriores::text, b.datos_nuevos::text))\n                  not like '%' || w || '%'));\n$function$\n",
