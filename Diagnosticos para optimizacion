		{
			"nombre": "pms_plan_extension_move",
			"esquema": "public",
			"retorno": "boolean",
			"lenguaje": "plpgsql",
			"argumentos": "p_reserva_id uuid, p_unidad_protegida uuid, p_depth integer, p_path_reservas uuid[], p_path_unidades uuid[]",
			"definicion": "CREATE OR REPLACE FUNCTION public.pms_plan_extension_move(p_reserva_id uuid, p_unidad_protegida uuid, p_depth integer, p_path_reservas uuid[], p_path_unidades uuid[])\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_temp', 'public'\nAS $function$\nDECLARE\n  v_reserva reservas%rowtype;\n  v_origen unidades%rowtype;\n  c record;\n  b record;\n  v_blockers uuid[];\nBEGIN\n  IF p_depth > 8 THEN\n    RETURN false;\n  END IF;\n\n  IF p_reserva_id = ANY(p_path_reservas) THEN\n    RETURN false;\n  END IF;\n\n  IF EXISTS (\n    SELECT 1\n    FROM pms_extension_plan p\n    WHERE p.reserva_id = p_reserva_id\n  ) THEN\n    RETURN true;\n  END IF;\n\n  SELECT *\n  INTO v_reserva\n  FROM public.reservas r\n  WHERE r.id = p_reserva_id;\n\n  IF NOT FOUND THEN\n    RETURN false;\n  END IF;\n\n  IF v_reserva.estado IN ('cancelada','no_show','en_casa','bloqueado') THEN\n    RETURN false;\n  END IF;\n\n  IF COALESCE(v_reserva.no_mover_unidad,false) THEN\n    RETURN false;\n  END IF;\n\n  SELECT *\n  INTO v_origen\n  FROM public.unidades u\n  WHERE u.id = v_reserva.unidad_id\n    AND u.activo;\n\n  IF NOT FOUND THEN\n    RETURN false;\n  END IF;\n\n  /*\n   * Intentar primero la misma categoría y luego categorías superiores.\n   */\n  FOR c IN\n    SELECT\n      u.id,\n      u.edificio_id,\n      u.tipo_unidad_id,\n      u.codigo,\n      u.orden,\n      CASE\n        WHEN u.tipo_unidad_id = v_origen.tipo_unidad_id THEN 0\n        ELSE 1\n      END AS prioridad\n    FROM public.unidades u\n    LEFT JOIN public.categoria_ranking_edificio rs\n      ON rs.edificio_id = v_origen.edificio_id\n      AND rs.tipo_unidad_id = v_origen.tipo_unidad_id\n    LEFT JOIN public.categoria_ranking_edificio rc\n      ON rc.edificio_id = u.edificio_id\n      AND rc.tipo_unidad_id = u.tipo_unidad_id\n    WHERE u.activo\n      AND u.edificio_id = v_origen.edificio_id\n      AND u.id <> v_reserva.unidad_id\n      AND u.id <> p_unidad_protegida\n      AND u.id <> ALL(p_path_unidades)\n      AND (\n        u.tipo_unidad_id = v_origen.tipo_unidad_id\n        OR COALESCE(rc.ranking,0) > COALESCE(rs.ranking,0)\n      )\n    ORDER BY prioridad, u.orden, u.codigo\n  LOOP\n\n    /*\n     * Cada candidato se intenta dentro de un sub-bloque para que, si\n     * una dependencia no puede ser acomodada, los cambios en la tabla\n     * temporal del plan se reviertan automáticamente.\n     */\n    BEGIN\n\n      /*\n       * Reservas que actualmente bloquean el candidato.\n       * Las que ya forman parte del plan se consideran movibles y no\n       * vuelven a bloquear el candidato.\n       */\n      SELECT COALESCE(\n        array_agg(q.id),\n        ARRAY[]::uuid[]\n      )\n      INTO v_blockers\n      FROM public.reservas q\n      WHERE q.unidad_id = c.id\n        AND q.id <> p_reserva_id\n        AND q.fecha_entrada < v_reserva.fecha_salida\n        AND q.fecha_salida > v_reserva.fecha_entrada\n        AND q.estado NOT IN ('cancelada','no_show')\n        AND NOT EXISTS (\n          SELECT 1\n          FROM pms_extension_plan pp\n          WHERE pp.reserva_id = q.id\n        );\n\n      /*\n       * No podemos mover reservas en casa, bloqueos ni reservas fijadas.\n       */\n      FOR b IN\n        SELECT\n          q.id,\n          q.estado,\n          q.no_mover_unidad\n        FROM public.reservas q\n        WHERE q.id = ANY(v_blockers)\n      LOOP\n        IF b.estado IN ('en_casa','bloqueado')\n           OR COALESCE(b.no_mover_unidad,false)\n        THEN\n          RAISE EXCEPTION USING ERRCODE = 'P0001', MESSAGE = 'DEPENDENCIA_NO_MOVIBLE';\n        END IF;\n      END LOOP;\n\n      /*\n       * Caso especial: intercambio directo.\n       *\n       * Si solo una reserva bloquea el candidato y puede ocupar la\n       * unidad actual de esta reserva una vez que esta se vaya, podemos\n       * resolver el movimiento en dos pasos:\n       *\n       *   actual:  A → B\n       *   blocker: B → A\n       *\n       * Esto es especialmente importante para cadenas y swaps.\n       */\n      IF COALESCE(array_length(v_blockers,1),0) = 1 THEN\n\n        SELECT q.*\n        INTO b\n        FROM public.reservas q\n        WHERE q.id = v_blockers[1];\n\n        IF b.estado NOT IN ('en_casa','bloqueado')\n           AND NOT COALESCE(b.no_mover_unidad,false)\n           AND b.id <> ALL(p_path_reservas)\n           AND NOT EXISTS (\n             SELECT 1\n             FROM pms_extension_plan pp\n             WHERE pp.reserva_id = b.id\n           )\n           AND NOT EXISTS (\n             SELECT 1\n             FROM public.reservas q2\n             WHERE q2.unidad_id = v_reserva.unidad_id\n               AND q2.id <> v_reserva.id\n               AND q2.id <> b.id\n               AND q2.fecha_entrada < b.fecha_salida\n               AND q2.fecha_salida > b.fecha_entrada\n               AND q2.estado NOT IN ('cancelada','no_show')\n               AND NOT EXISTS (\n                 SELECT 1\n                 FROM pms_extension_plan pp2\n                 WHERE pp2.reserva_id = q2.id\n               )\n           )\n           AND NOT EXISTS (\n             SELECT 1\n             FROM pms_extension_plan pp3\n             JOIN public.reservas qq3\n               ON qq3.id = pp3.reserva_id\n             WHERE pp3.unidad_destino = v_reserva.unidad_id\n               AND pp3.reserva_id <> b.id\n               AND qq3.fecha_entrada < b.fecha_salida\n               AND qq3.fecha_salida > b.fecha_entrada\n           )\n        THEN\n\n          INSERT INTO pms_extension_plan(\n            reserva_id,\n            unidad_origen,\n            unidad_destino,\n            profundidad,\n            fecha_entrada,\n            fecha_salida\n          )\n          VALUES(\n            b.id,\n            b.unidad_id,\n            v_reserva.unidad_id,\n            p_depth + 1,\n            b.fecha_entrada,\n            b.fecha_salida\n          );\n\n          INSERT INTO pms_extension_plan(\n            reserva_id,\n   