			"lenguaje": "sql",
			"argumentos": "p_edificio uuid",
			"definicion": "CREATE OR REPLACE FUNCTION public.tablero_limpieza(p_edificio uuid DEFAULT NULL::uuid)\n RETURNS TABLE(unidad_id uuid, unidad_codigo text, categoria text, edificio_id uuid, edificio text, fecha_salida date, hora_salida_aprox time without time zone, reserva_estado text, hay_ingreso boolean, hora_llegada time without time zone, limpieza_id uuid, estado estado_limpieza, observacion_recepcion text, observacion_limpieza text, pendiente_desde timestamp with time zone)\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\n  with hoy as (\r\n    select (now() at time zone 'America/Santiago')::date as d\r\n  )\r\n  select u.id,\r\n         u.codigo::text,\r\n         coalesce(t.nombre, '')::text,\r\n         e.id,\r\n         e.nombre::text,\r\n         s.fecha_salida,\r\n         s.hora_salida_aprox::time,\r\n         s.estado::text,\r\n         (i.unidad_id is not null),\r\n         i.hora_llegada_aprox::time,\r\n         l.id,\r\n         l.estado,\r\n         l.observacion_recepcion,\r\n         l.observacion_limpieza,\r\n         case when s.unidad_id is null then l.creado_en::timestamptz end\r\n  from unidades u\r\n  join edificios e on e.id = u.edificio_id\r\n  left join tipos_unidad t on t.id = u.tipo_unidad_id\r\n  cross join hoy\r\n  left join lateral (\r\n    select r.unidad_id, r.fecha_salida, r.hora_salida_aprox, r.estado\r\n    from reservas r\r\n    where r.unidad_id = u.id\r\n      and r.fecha_salida = hoy.d\r\n      and r.estado in ('en_casa', 'check_out')\r\n    order by r.salida_real desc nulls last\r\n    limit 1\r\n  ) s on true\r\n  left join lateral (\r\n    select r.unidad_id, r.hora_llegada_aprox\r\n    from reservas r\r\n    where r.unidad_id = u.id\r\n      and r.fecha_entrada = hoy.d\r\n      and r.estado in ('confirmada', 'en_casa')\r\n    order by r.hora_llegada_aprox nulls last\r\n    limit 1\r\n  ) i on true\r\n  left join lateral (\r\n    select x.*\r\n    from limpieza x\r\n    where x.unidad_id = u.id\r\n    order by x.creado_en desc\r\n    limit 1\r\n  ) l on true\r\n  where rol_actual() is not null\r\n    and u.activo\r\n    and public.puede_ver_edificio(e.id)\r\n    and (p_edificio is null or u.edificio_id = p_edificio)\r\n    and (s.unidad_id is not null or l.estado in ('sucia', 'en_proceso', 'defectuosa'))\r\n  order by e.orden, u.codigo;\r\n$function$\n",
