        WHERE pp.unidad_destino = c.id\n          AND pp.reserva_id <> p_reserva_id\n          AND qq.fecha_entrada < v_reserva.fecha_salida\n          AND qq.fecha_salida > v_reserva.fecha_entrada\n      ) THEN\n        RAISE EXCEPTION USING ERRCODE = 'P0001', MESSAGE = 'PLAN_SUPERPUESTO';\n      END IF;\n\n\n      INSERT INTO pms_extension_plan(\n        reserva_id,\n        unidad_origen,\n        unidad_destino,\n        profundidad,\n        fecha_entrada,\n        fecha_salida\n      )\n      VALUES(\n        p_reserva_id,\n        v_reserva.unidad_id,\n        c.id,\n        p_depth,\n        v_reserva.fecha_entrada,\n        v_reserva.fecha_salida\n      );\n\n      RETURN true;\n\n    EXCEPTION\n      WHEN SQLSTATE 'P0001' THEN\n        /*\n         * El bloque EXCEPTION crea un sub-bloque transaccional.\n         * Al fallar esta alternativa, cualquier inserción de dependencias\n         * realizada dentro de ella se revierte y probamos la siguiente.\n         */\n        NULL;\n    END;\n\n  END LOOP;\n\n  RETURN false;\nEND;\n$function$\n",
