			"definicion": "CREATE OR REPLACE FUNCTION public.hacer_check_out(p_reserva_id uuid, p_nota text DEFAULT NULL::text, p_obs_limpieza text DEFAULT NULL::text)\n RETURNS void\n LANGUAGE plpgsql\nAS $function$\r\ndeclare r reservas%rowtype;\r\nbegin\r\n  select * into r from reservas where id = p_reserva_id for update;\r\n  if r.estado <> 'en_casa' then\r\n    raise exception 'La reserva no esta en casa';\r\n  end if;\r\n\r\n  update reservas set estado = 'check_out', salida_real = now() where id = r.id;\r\n\r\n  if p_nota is not null and length(trim(p_nota)) > 0 then\r\n    insert into notas_huesped (huesped_id, reserva_id, nota, creado_por)\r\n    values (r.huesped_id, r.id, p_nota, auth.uid());\r\n  end if;\r\n\r\n  -- Deja la unidad \"sucia\" con la observación para limpieza.\r\n  -- Si ya existe una limpieza pendiente (la que crea el sistema al hacer check-out), solo le agrega la observación.\r\n  perform pedir_limpieza(r.unidad_id, p_obs_limpieza);\r\nend $function$\n",
