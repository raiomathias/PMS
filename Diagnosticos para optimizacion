			"argumentos": "p_origen uuid, p_destino uuid",
			"definicion": "CREATE OR REPLACE FUNCTION public.pms_destino_reacomodacion_permitido(p_origen uuid, p_destino uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n  SELECT EXISTS (\n    SELECT 1\n      FROM public.unidades s\n      JOIN public.unidades c ON c.edificio_id = s.edificio_id\n     WHERE s.id = p_origen\n       AND c.id = p_destino\n       AND c.activo\n       AND c.id <> s.id\n       AND (\n         c.tipo_unidad_id IS NOT DISTINCT FROM s.tipo_unidad_id\n         OR COALESCE((SELECT max(rc.ranking) FROM public.categoria_ranking_edificio rc\n                       WHERE rc.edificio_id = c.edificio_id\n                         AND rc.tipo_unidad_id = c.tipo_unidad_id), 0)\n          > COALESCE((SELECT max(rs.ranking) FROM public.categoria_ranking_edificio rs\n                       WHERE rs.edificio_id = s.edificio_id\n                         AND rs.tipo_unidad_id = s.tipo_unidad_id), 0)\n       )\n  );\n$function$\n",
