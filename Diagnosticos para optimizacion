			"definicion": "CREATE OR REPLACE FUNCTION public.recalcular_estado_pago(p_reserva_id uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\ndeclare v_nuevo estado_pago;\r\nbegin\r\n  select (case\r\n            when r.estado_pago = 'reembolsado' then 'reembolsado'\r\n            when s.total_a_pagar > 0 and s.total_pagado >= s.total_a_pagar then 'pagado'\r\n            else 'pendiente'\r\n          end)::estado_pago\r\n    into v_nuevo\r\n    from reservas r\r\n    join saldo_reserva s on s.reserva_id = r.id\r\n   where r.id = p_reserva_id;\r\n\r\n  if v_nuevo is null then return; end if;\r\n\r\n  update reservas set estado_pago = v_nuevo\r\n   where id = p_reserva_id and estado_pago is distinct from v_nuevo;\r\nend $function$\n",
