			"argumentos": "p_solicitud_id uuid, p_aprobar boolean, p_motivo text",
			"definicion": "CREATE OR REPLACE FUNCTION public.resolver_solicitud_lista_negra(p_solicitud_id uuid, p_aprobar boolean, p_motivo text DEFAULT NULL::text)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\ndeclare\n  s public.lista_negra_solicitudes%rowtype;\n  v_rol text;\nbegin\n  select p.rol into v_rol\n  from public.perfiles p\n  where p.id=auth.uid()\n    and p.activo;\n\n  if v_rol is null or v_rol not in ('administracion','gerencia','sysadmin') then\n    raise exception 'Solo Administración, Gerencia o SysAdmin puede resolver solicitudes';\n  end if;\n\n  select * into s\n  from public.lista_negra_solicitudes\n  where id=p_solicitud_id\n  for update;\n\n  if not found then raise exception 'Solicitud no encontrada'; end if;\n  if s.estado <> 'pendiente' then raise exception 'La solicitud ya fue resuelta'; end if;\n\n  if p_aprobar then\n    if exists (\n      select 1\n      from public.lista_negra l\n      where l.activo\n        and (\n          (\n            nullif(trim(s.documento_normalizado),'') is not null\n            and nullif(trim(l.documento_normalizado),'') is not null\n            and l.documento_normalizado=s.documento_normalizado\n          )\n          or (\n            nullif(trim(s.numero_documento),'') is not null\n            and nullif(trim(l.numero_documento),'') is not null\n            and lower(trim(l.numero_documento))=lower(trim(s.numero_documento))\n          )\n          or (\n            nullif(trim(s.documento_normalizado),'') is null\n            and nullif(trim(s.numero_documento),'') is null\n            and public.normalizar_nombre_lista_negra(l.nombre_completo)\n                = public.normalizar_nombre_lista_negra(s.nombre_completo)\n          )\n        )\n    ) then\n      raise exception 'Este huésped ya tiene una entrada activa en la lista negra';\n    end if;\n\n    insert into public.lista_negra(\n      nombre_completo,\n      nombre_normalizado,\n      tipo_documento,\n      numero_documento,\n      documento_normalizado,\n      motivo,\n      activo,\n      agregado_por,\n      agregado_en\n    )\n    values(\n      s.nombre_completo,\n      public.normalizar_nombre_lista_negra(s.nombre_completo),\n      s.tipo_documento,\n      s.numero_documento,\n      s.documento_normalizado,\n      s.motivo,\n      true,\n      auth.uid(),\n      now()\n    );\n\n    update public.lista_negra_solicitudes\n    set estado='aprobada',\n        revisado_por=auth.uid(),\n        revisado_en=now(),\n        decision_motivo=nullif(trim(p_motivo),'')\n    where id=s.id;\n\n  else\n    if nullif(trim(p_motivo),'') is null then\n      raise exception 'Debes indicar un motivo para rechazar';\n    end if;\n\n    update public.lista_negra_solicitudes\n    set estado='rechazada',\n        revisado_por=auth.uid(),\n        revisado_en=now(),\n        decision_motivo=trim(p_motivo)\n    where id=s.id;\n  end if;\nend;\n$function$\n",
