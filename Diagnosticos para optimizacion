			"definicion": "CREATE OR REPLACE FUNCTION public.pms_planificar_liberacion(p_unidad uuid, p_entrada date, p_salida date, p_excluir uuid DEFAULT NULL::uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nDECLARE\n  v_bloq uuid[];\n  v_intocables integer;\n  v_res jsonb;\n  v_mov jsonb;\n  v_plan jsonb;\n  v_n integer;\nBEGIN\n  IF p_unidad IS NULL OR p_entrada IS NULL OR p_salida IS NULL OR p_salida <= p_entrada THEN\n    RETURN NULL;\n  END IF;\n  IF NOT EXISTS (SELECT 1 FROM public.unidades u WHERE u.id = p_unidad AND u.activo) THEN\n    RETURN NULL;\n  END IF;\n\n  SELECT COALESCE(array_agg(r.id ORDER BY r.fecha_entrada, r.id), ARRAY[]::uuid[]),\n         count(*) FILTER (WHERE r.estado IN ('en_casa','bloqueado') OR COALESCE(r.no_mover_unidad, false))\n    INTO v_bloq, v_intocables\n    FROM public.reservas r\n   WHERE r.unidad_id = p_unidad\n     AND r.id IS DISTINCT FROM p_excluir\n     AND r.estado IN ('tentativa','confirmada','en_casa','bloqueado')\n     AND r.fecha_entrada < p_salida\n     AND r.fecha_salida > p_entrada;\n\n  IF cardinality(v_bloq) = 0 THEN RETURN '[]'::jsonb; END IF;\n  IF v_intocables > 0 THEN RETURN NULL; END IF;\n\n  v_res := public.pms_resolver_liberacion(\n    v_bloq, '{}'::jsonb, p_unidad, p_entrada, p_salida, p_excluir, 10, 600\n  );\n  IF jsonb_typeof(v_res -> 'mov') <> 'object' THEN RETURN NULL; END IF;\n  v_mov := v_res -> 'mov';\n\n  -- Verificación independiente del resultado: ningún cruce y destino libre.\n  IF EXISTS (\n       SELECT 1\n         FROM jsonb_each_text(v_mov) m\n         JOIN public.reservas x ON x.id = m.key::uuid\n         JOIN public.reservas y\n           ON y.id <> x.id\n          AND y.id IS DISTINCT FROM p_excluir\n          AND y.estado IN ('tentativa','confirmada','en_casa','bloqueado')\n          AND COALESCE((v_mov ->> (y.id::text))::uuid, y.unidad_id) = m.value::uuid\n          AND y.fecha_entrada < x.fecha_salida\n          AND y.fecha_salida > x.fecha_entrada\n     )\n     OR EXISTS (\n       SELECT 1\n         FROM jsonb_each_text(v_mov) m\n         JOIN public.reservas x ON x.id = m.key::uuid\n        WHERE m.value::uuid = p_unidad\n          AND x.fecha_entrada < p_salida\n          AND x.fecha_salida > p_entrada\n     )\n     OR EXISTS (\n       SELECT 1\n         FROM public.reservas y\n        WHERE y.unidad_id = p_unidad\n          AND y.id IS DISTINCT FROM p_excluir\n          AND y.estado IN ('tentativa','confirmada','en_casa','bloqueado')\n          AND y.fecha_entrada < p_salida\n          AND y.fecha_salida > p_entrada\n          AND (v_mov ->> (y.id::text)) IS NULL\n     )\n  THEN\n    RETURN NULL;\n  END IF;\n\n  SELECT COALESCE(jsonb_agg(\n           jsonb_build_object(\n             'reserva_id', r.id,\n             'unidad_origen', r.unidad_id,\n             'unidad_destino', m.value::uuid,\n             'profundidad', CASE WHEN r.unidad_id = p_unidad THEN 1 ELSE 2 END\n           )\n           ORDER BY CASE WHEN r.unidad_id = p_unidad THEN 1 ELSE 2 END DESC,\n                    r.fecha_entrada, r.id\n         ), '[]'::jsonb),\n         count(*)\n    INTO v_plan, v_n\n    FROM jsonb_each_text(v_mov) m\n    JOIN public.reservas r ON r.id = m.key::uuid;\n\n  IF v_n <> (SELECT count(*) FROM jsonb_object_keys(v_mov)) THEN RETURN NULL; END IF;\n  RETURN v_plan;\nEND;\n$function$\n",
