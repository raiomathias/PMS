			"definicion": "CREATE OR REPLACE FUNCTION public.mover_reserva(p_reserva_id uuid, p_unidad_id uuid, p_entrada date, p_salida date, p_tarifa integer DEFAULT NULL::integer)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\ndeclare\n  r reservas%rowtype;\nbegin\n  select * into r\n  from reservas\n  where id = p_reserva_id\n  for update;\n\n  if not found then\n    raise exception 'Reserva no encontrada';\n  end if;\n\n  if r.estado = 'en_casa' then\n    raise exception 'Una persona que ya está en casa nunca puede ser movida de unidad';\n  end if;\n\n  if r.estado not in ('tentativa','confirmada','bloqueado') then\n    raise exception 'Esta reserva ya no se puede mover';\n  end if;\n\n  if p_salida <= p_entrada then\n    raise exception 'La salida debe ser posterior a la entrada';\n  end if;\n\n  if exists (\n    select 1\n    from reservas x\n    where x.id <> r.id\n      and x.unidad_id = p_unidad_id\n      and x.estado in ('tentativa','confirmada','en_casa','bloqueado')\n      and x.fecha_entrada < p_salida\n      and x.fecha_salida > p_entrada\n  ) then\n    raise exception 'La unidad ya está ocupada en esas fechas';\n  end if;\n\n  update reservas\n  set unidad_id = p_unidad_id,\n      fecha_entrada = p_entrada,\n      fecha_salida = p_salida,\n      tarifa_noche = coalesce(p_tarifa, tarifa_noche)\n  where id = r.id;\nend;\n$function$\n",
