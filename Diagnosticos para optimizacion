		{
			"nombre": "editar_reserva_completa",
			"esquema": "public",
			"retorno": "void",
			"lenguaje": "plpgsql",
			"argumentos": "p_reserva_id uuid, p_huesped_nombre text, p_tipo_documento text, p_numero_documento text, p_telefono text, p_correo text, p_nacionalidad text, p_ciudad_origen text, p_estado text, p_fecha_entrada date, p_fecha_salida date, p_unidad_id uuid, p_canal text, p_referencia_externa text, p_adultos integer, p_menores integer, p_tarifa_noche integer, p_total_manual integer, p_modelo_vehiculo text, p_patente_vehiculo text, p_cupo_estacionamiento integer, p_usa_estacionamiento boolean, p_observaciones text, p_iva_total integer, p_otro_precio integer, p_noches_estacionamiento integer",
			"definicion": "CREATE OR REPLACE FUNCTION public.editar_reserva_completa(p_reserva_id uuid, p_huesped_nombre text DEFAULT NULL::text, p_tipo_documento text DEFAULT NULL::text, p_numero_documento text DEFAULT NULL::text, p_telefono text DEFAULT NULL::text, p_correo text DEFAULT NULL::text, p_nacionalidad text DEFAULT NULL::text, p_ciudad_origen text DEFAULT NULL::text, p_estado text DEFAULT NULL::text, p_fecha_entrada date DEFAULT NULL::date, p_fecha_salida date DEFAULT NULL::date, p_unidad_id uuid DEFAULT NULL::uuid, p_canal text DEFAULT NULL::text, p_referencia_externa text DEFAULT NULL::text, p_adultos integer DEFAULT NULL::integer, p_menores integer DEFAULT NULL::integer, p_tarifa_noche integer DEFAULT NULL::integer, p_total_manual integer DEFAULT NULL::integer, p_modelo_vehiculo text DEFAULT NULL::text, p_patente_vehiculo text DEFAULT NULL::text, p_cupo_estacionamiento integer DEFAULT NULL::integer, p_usa_estacionamiento boolean DEFAULT NULL::boolean, p_observaciones text DEFAULT NULL::text, p_iva_total integer DEFAULT NULL::integer, p_otro_precio integer DEFAULT NULL::integer, p_noches_estacionamiento integer DEFAULT NULL::integer)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\nDECLARE\n  r reservas%rowtype;\n  v_user uuid := auth.uid();\n  v_ent date;\n  v_sal date;\n  v_unit uuid;\n  v_iva integer;\n  v_otro integer;\n  v_npark integer;\n  v_base_total integer;\n  v_ajuste integer;\nBEGIN\n  SELECT *\n  INTO r\n  FROM reservas\n  WHERE id = p_reserva_id\n  FOR UPDATE;\n\n  IF NOT FOUND THEN\n    RAISE EXCEPTION 'Reserva no encontrada';\n  END IF;\n\n  IF v_user IS NULL THEN\n    RAISE EXCEPTION 'Sesión no válida';\n  END IF;\n\n  v_ent := COALESCE(p_fecha_entrada, r.fecha_entrada);\n  v_sal := COALESCE(p_fecha_salida, r.fecha_salida);\n  v_unit := COALESCE(p_unidad_id, r.unidad_id);\n\n  v_iva := GREATEST(0, COALESCE(p_iva_total, 0));\n  v_otro := GREATEST(0, COALESCE(p_otro_precio, 0));\n\n  v_npark := GREATEST(\n    0,\n    COALESCE(\n      p_noches_estacionamiento,\n      r.noches_estacionamiento,\n      CASE\n        WHEN r.usa_estacionamiento\n        THEN r.fecha_salida - r.fecha_entrada\n        ELSE 0\n      END\n    )\n  );\n\n  IF v_sal <= v_ent THEN\n    RAISE EXCEPTION 'La salida debe ser posterior a la entrada';\n  END IF;\n\n  IF p_canal IS NOT NULL\n     AND p_canal = 'booking'\n     AND NULLIF(TRIM(COALESCE(p_referencia_externa, '')), '') IS NULL\n     AND public.tiene_permiso_edicion(v_user, 'channel')\n  THEN\n    RAISE EXCEPTION 'El código externo es obligatorio para Booking';\n  END IF;\n\n  IF v_npark > (v_sal - v_ent) THEN\n    RAISE EXCEPTION 'Las noches con estacionamiento no pueden superar la estadía';\n  END IF;\n\n  IF r.estado = 'en_casa'\n     AND v_unit <> r.unidad_id\n  THEN\n    RAISE EXCEPTION 'Una persona que ya está en casa nunca puede ser movida de unidad';\n  END IF;\n\n  -- HUÉSPED\n  IF p_huesped_nombre IS NOT NULL\n     AND (\n       public.tiene_permiso_edicion(v_user, 'guest_name')\n       OR public.rol_actual() IN (\n         'recepcion',\n         'administracion',\n         'gerencia',\n         'sysadmin'\n       )\n     )\n  THEN\n    UPDATE huespedes\n    SET nombre_completo = p_huesped_nombre\n    WHERE id = r.huesped_id;\n\n    UPDATE reservas\n    SET huesped_nombre_copia = p_huesped_nombre\n    WHERE id = r.id;\n  END IF;\n\n  -- DOCUMENTO DEL HUÉSPED\n  -- Recepción y perfiles administrativos pueden guardarlo\n  -- mediante el botón universal Guardar Cambios.\n  IF public.tiene_permiso_edicion(v_user, 'guest_document')\n     OR public.rol_actual() IN (\n       'recepcion',\n       'administracion',\n       'gerencia',\n       'sysadmin'\n     )\n  THEN\n    UPDATE huespedes\n    SET\n      tipo_documento =\n        COALESCE(\n          NULLIF(TRIM(p_tipo_documento), ''),\n          tipo_documento\n        ),\n      numero_documento =\n        COALESCE(\n          NULLIF(TRIM(p_numero_documento), ''),\n          numero_documento\n        )\n    WHERE id = r.huesped_id;\n  END IF;\n\n  -- CONTACTO\n  IF public.tiene_permiso_edicion(v_user, 'guest_contact')\n     OR public.rol_actual() IN (\n       'recepcion',\n       'administracion',\n       'gerencia',\n       'sysadmin'\n     )\n  THEN\n    UPDATE huespedes\n    SET\n      telefono = COALESCE(p_telefono, telefono),\n      correo = COALESCE(p_correo, correo),\n      nacionalidad = COALESCE(p_nacionalidad, nacionalidad),\n      ciudad_origen = COALESCE(p_ciudad_origen, ciudad_origen)\n    WHERE id = r.huesped_id;\n  END IF;\n\n  -- ESTADO\n  IF p_estado IS NOT NULL\n     AND public.tiene_permiso_edicion(v_user, 'status')\n  THEN\n    UPDATE reservas\n    SET estado = p_estado::estado_reserva\n    WHERE id = r.id;\n  END IF;\n\n  -- CANAL\n  IF public.tiene_permiso_edicion(v_user, 'channel') THEN\n    UPDATE reservas\n    SET\n      canal = COALESCE(p_canal::canal_reserva, canal),\n      referencia_externa =\n        CASE\n          WHEN p_referencia_externa IS NULL\n          THEN referencia_externa\n          ELSE NULLIF(TRIM(p_referencia_externa), '')\n        END\n    WHERE id = r.id;\n  END IF;\n\n  -- OCUPACIÓN\n  IF public.tiene_permiso_edicion(v_user, 'occupancy') THEN\n    UPDATE reservas\n    SET\n      adultos = COALESCE(p_adultos, adultos),\n      menores = COALESCE(p_menores, menores)\n    WHERE id = r.id;\n  END IF;\n\n  -- TARIFA\n  IF public.tiene_permiso_edicion(v_user, 'rate') THEN\n    UPDATE reservas\n    SET tarifa_noche = COALESCE(p_tarifa_noche, tarifa_noche)\n    WHERE id = r.id;\n  END IF;\n\n  -- VEHÍCULO / ESTACIONAMIENTO\n  IF public.tiene_permiso_edicion(v_user, 'vehicle') THEN\n\n    IF COALESCE(p_usa_estacionamiento, r.usa_estacionamiento)\n       AND NULLIF(\n         TRIM(COALESCE(p_modelo_vehiculo, r.modelo_vehiculo, '')),\n         ''\n       ) IS NULL\n    THEN\n      RAISE EXCEPTION\n        'Para usar estacionamiento debes indicar el modelo del vehículo';\n    END IF;\n\n    IF COALESCE(p_usa_estacionamiento, r.usa_estacionamiento)\n       AND NULLIF(\n         TRIM(COALESCE(p_patente_vehiculo, r.patente_vehiculo, '')),\n         ''\n       ) IS NULL\n    THEN\n      RAISE EXCEPTION\n        'Para usar estacionamiento debes indicar la patente del vehículo';\n    END IF;\n\n    UPDATE reservas\n    SET\n      modelo_vehiculo =\n        COALESCE(\n          NULLIF(TRIM(p_modelo_vehiculo), ''),\n          modelo_vehiculo\n        ),\n      patente_vehiculo =\n        COALESCE(\n          NULLIF(TRIM(p_patente_vehiculo), ''),\n          patente_vehiculo\n        ),\n      cupo_estacionamiento = p_cupo_estacionamiento,\n      usa_estacionamiento =\n        COALESCE(p_usa_estacionamiento, usa_estacionamiento)\n    WHERE id = r.id;\n  END IF;\n\n  -- OBSERVACIONES\n  IF public.tiene_permiso_edicion(v_user, 'observations') THEN\n    UPDATE reservas\n    SET observaciones = p_observaciones\n    WHERE id = r.id;\n  END IF;\n\n  -- FECHAS / UNIDAD\n  IF public.tiene_permiso_edicion(v_user, 'dates')\n     OR public.tiene_permiso_edicion(v_user, 'building_category_unit')\n  THEN\n\n    IF r.estado = 'en_casa'\n       AND v_unit <> r.unidad_id\n    THEN\n      RAISE EXCEPTION\n        'Una persona que ya está en casa nunca puede ser movida de unidad';\n    END IF;\n\n    IF EXISTS (\n      SELECT 1\n      FROM reservas x\n      WHERE x.id <> r.id\n        AND x.unidad_id = v_unit\n        AND x.estado IN (\n          'tentativa',\n          'confirmada',\n          'en_casa',\n          'bloqueado'\n        )\n        AND x.fecha_entrada < v_sal\n        AND x.fecha_salida > v_ent\n    )\n    THEN\n      RAISE EXCEPTION\n        'La unidad ya está ocupada en esas fechas';\n    END IF;\n\n    UPDATE reservas\n    SET\n      unidad_id = v_unit,\n      fecha_entrada = v_ent,\n      fecha_salida = v_sal\n    WHERE id = r.id;\n  END IF;\n\n  -- IVA\n  IF public.tiene_permiso_edicion(v_user, 'price_iva') THEN\n\n    DELETE FROM cargos\n    WHERE reserva_id = r.id\n      AND descripcion = '__PMS_IVA__';\n\n    IF v_iva > 0 THEN\n      INSERT INTO cargos(\n        reserva_id,\n        tipo,\n        descripcion,\n        cantidad,\n        monto_unitario\n      )\n      VALUES (\n        r.id,\n        'otro',\n        '__PMS_IVA__',\n        1,\n        v_iva\n      );\n    END IF;\n  END IF;\n\n  -- OTRO PRECIO\n  IF public.tiene_permiso_edicion(v_user, 'price_other') THEN\n\n    DELETE FROM cargos\n    WHERE reserva_id = r.id\n      AND descripcion = '__PMS_OTRO_PRECIO__';\n\n    IF v_otro > 0 THEN\n      INSERT INTO cargos(\n        reserva_id,\n        tipo,\n        descripcion,\n        cantidad,\n        monto_unitario\n      )\n      VALUES (\n        r.id,\n        'otro',\n        '__PMS_OTRO_PRECIO__',\n        1,\n        v_otro\n      );\n    END IF;\n  END IF;\n\n  -- NOCHES DE ESTACIONAMIENTO\n  IF public.tiene_permiso_edicion(v_user, 'parking_nights') THEN\n    UPDATE reservas\n    SET noches_estacionamiento =\n      CASE\n        WHEN COALESCE(\n          p_usa_estacionamiento,\n          r.usa_estacionamiento\n        )\n        THEN v_npark\n        ELSE 0\n      END\n    WHERE id = r.id;\n  END IF;\n\n  -- TOTAL MANUAL\n  IF p_total_manual IS NOT NULL\n     AND public.tiene_permiso_edicion(v_user, 'total')\n  THEN\n\n    DELETE FROM cargos\n    WHERE reserva_id = r.id\n      AND tipo = 'otro'\n      AND descripcion = '__PMS_AJUSTE_TOTAL_MANUAL__';\n\n    SELECT\n      (\n        (v_sal - v_ent)\n        * COALESCE(\n            (\n              SELECT tarifa_noche\n              FROM reservas\n              WHERE id = r.id\n            ),\n            r.tarifa_noche\n          )\n      )\n      +\n      COALESCE(\n        SUM(\n          CASE\n            WHEN descripcion <> '__PMS_AJUSTE_TOTAL_MANUAL__'\n            THEN total\n            ELSE 0\n          END\n        ),\n        0\n      )\n    INTO v_base_total\n    FROM cargos\n    WHERE reserva_id = r.id;\n\n    v_ajuste =\n      p_total_manual - COALESCE(v_base_total, 0);\n\n    IF v_ajuste <> 0 THEN\n      INSERT INTO cargos(\n        reserva_id,\n        tipo,\n        descripcion,\n        cantidad,\n        monto_unitario\n      )\n      VALUES (\n        r.id,\n        'otro',\n        '__PMS_AJUSTE_TOTAL_MANUAL__',\n        1,\n        v_ajuste\n      );\n    END IF;\n  END IF;\n\nEND;\n$function$\n",
