			"definicion": "CREATE OR REPLACE FUNCTION public.noches_estacionamiento_reserva(p_reserva_id uuid)\n RETURNS integer\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  select coalesce(r.noches_estacionamiento, case when r.usa_estacionamiento then r.fecha_salida-r.fecha_entrada else 0 end)\n  from reservas r where r.id=p_reserva_id;\n$function$\n",
