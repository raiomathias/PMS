			"definicion": "CREATE OR REPLACE FUNCTION public.pedir_limpieza(p_unidad_id uuid, p_observacion text DEFAULT NULL::text)\n RETURNS uuid\n LANGUAGE plpgsql\nAS $function$\r\ndeclare\r\n  v_id uuid;\r\n  v_estado estado_limpieza;\r\n  v_obs text := nullif(trim(coalesce(p_observacion, '')), '');\r\nbegin\r\n  if not es_personal() then\r\n    raise exception 'No autorizado';\r\n  end if;\r\n\r\n  select id, estado into v_id, v_estado\r\n  from limpieza\r\n  where unidad_id = p_unidad_id\r\n  order by creado_en desc\r\n  limit 1;\r\n\r\n  if v_id is not null and v_estado in ('sucia', 'en_proceso', 'defectuosa') then\r\n    update limpieza\r\n       set observacion_recepcion = coalesce(v_obs, observacion_recepcion),\r\n           estado = case when v_estado = 'defectuosa' then 'sucia'::estado_limpieza else v_estado end,\r\n           actualizado_por = auth.uid()\r\n     where id = v_id;\r\n    return v_id;\r\n  end if;\r\n\r\n  insert into limpieza (unidad_id, estado, observacion_recepcion, actualizado_por)\r\n  values (p_unidad_id, 'sucia', v_obs, auth.uid())\r\n  returning id into v_id;\r\n  return v_id;\r\nend $function$\n",
