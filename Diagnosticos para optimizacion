			"definicion": "CREATE OR REPLACE FUNCTION public.calcular_recargo_horario(p_hora_pactada time without time zone, p_hora_estandar time without time zone, p_hora_limite time without time zone, p_tarifa_hora integer)\n RETURNS integer\n LANGUAGE plpgsql\n STABLE\nAS $function$\r\ndeclare v_horas int;\r\nbegin\r\n  if p_hora_pactada = p_hora_estandar then return 0; end if;\r\n  if p_hora_pactada not between least(p_hora_estandar, p_hora_limite)\r\n                            and greatest(p_hora_estandar, p_hora_limite) then\r\n    return null;\r\n  end if;\r\n  v_horas := ceil(abs(extract(epoch from (p_hora_pactada - p_hora_estandar))) / 3600.0);\r\n  return v_horas * p_tarifa_hora;\r\nend $function$\n",
