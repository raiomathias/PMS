			"definicion": "CREATE OR REPLACE FUNCTION public.cancelar_reserva(p_reserva_id uuid, p_motivo text)\n RETURNS integer\n LANGUAGE plpgsql\nAS $function$\r\ndeclare\r\n  r reservas%rowtype;\r\n  v_horas_limite int  := (select valor::int  from configuracion where clave = 'cancelacion_horas_sin_cargo');\r\n  v_noches_cobro int  := (select valor::int  from configuracion where clave = 'cancelacion_noches_cobradas');\r\n  v_hora_entrada time := (select valor::time from configuracion where clave = 'hora_check_in');\r\n  v_horas_restantes numeric;\r\n  v_cargo int := 0;\r\nbegin\r\n  select * into r from reservas where id = p_reserva_id for update;\r\n  if r.estado not in ('tentativa','confirmada') then\r\n    raise exception 'Solo se pueden cancelar reservas tentativas o confirmadas';\r\n  end if;\r\n\r\n  v_horas_restantes := extract(epoch from\r\n    ((r.fecha_entrada + v_hora_entrada) - (now() at time zone 'America/Santiago'))) / 3600;\r\n\r\n  if v_horas_restantes < v_horas_limite then\r\n    v_cargo := r.tarifa_noche * v_noches_cobro;\r\n    insert into cargos (reserva_id, tipo, descripcion, cantidad, monto_unitario, creado_por)\r\n    values (r.id, 'cancelacion', 'Cancelacion con menos de ' || v_horas_limite || ' h', 1, v_cargo, auth.uid());\r\n  end if;\r\n\r\n  update reservas\r\n     set estado = 'cancelada', motivo_cancelacion = p_motivo,\r\n         cancelada_en = now(), cancelada_por = auth.uid()\r\n   where id = r.id;\r\n\r\n  insert into notas_huesped (huesped_id, reserva_id, nota, categoria, gravedad, creado_por)\r\n  values (r.huesped_id, r.id,\r\n          'Cancelo la reserva ' || r.uid_reserva || ' (entrada ' || r.fecha_entrada || ')',\r\n          'cancelacion', 1, auth.uid());\r\n\r\n  return v_cargo;\r\nend $function$\n",
