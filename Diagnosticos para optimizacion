			"argumentos": "p_huesped_id uuid, p_unidad_id uuid, p_fecha_entrada date, p_fecha_salida date, p_estado estado_reserva, p_canal canal_reserva, p_referencia_externa text, p_adultos integer, p_menores integer, p_tarifa_noche integer, p_usa_estacionamiento boolean, p_noches_estacionamiento integer, p_modelo_vehiculo text, p_patente_vehiculo text, p_plan jsonb",
			"definicion": "CREATE OR REPLACE FUNCTION public.pms_crear_reserva_con_reacomodacion(p_huesped_id uuid, p_unidad_id uuid, p_fecha_entrada date, p_fecha_salida date, p_estado estado_reserva DEFAULT 'confirmada'::estado_reserva, p_canal canal_reserva DEFAULT 'directo'::canal_reserva, p_referencia_externa text DEFAULT NULL::text, p_adultos integer DEFAULT 1, p_menores integer DEFAULT 0, p_tarifa_noche integer DEFAULT 0, p_usa_estacionamiento boolean DEFAULT false, p_noches_estacionamiento integer DEFAULT 0, p_modelo_vehiculo text DEFAULT NULL::text, p_patente_vehiculo text DEFAULT NULL::text, p_plan jsonb DEFAULT '[]'::jsonb)\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\nDECLARE\n    x jsonb;\n    r public.reservas%rowtype;\n    v_id uuid;\n    v_noches integer;\nBEGIN\n    IF p_fecha_salida <= p_fecha_entrada THEN\n        RAISE EXCEPTION 'La salida debe ser posterior a la entrada';\n    END IF;\n\n    IF p_canal::text = 'booking'\n       AND NULLIF(trim(COALESCE(p_referencia_externa,'')), '') IS NULL\n    THEN\n        RAISE EXCEPTION 'El código externo del canal es obligatorio para Booking';\n    END IF;\n\n    v_noches := p_fecha_salida - p_fecha_entrada;\n\n    IF p_noches_estacionamiento < 0 OR p_noches_estacionamiento > v_noches THEN\n        RAISE EXCEPTION 'Las noches con estacionamiento no pueden superar la estadía';\n    END IF;\n\n    -- Bloquear todas las reservas que intervienen en el plan antes de mover.\n    IF jsonb_typeof(COALESCE(p_plan,'[]'::jsonb)) <> 'array' THEN\n        RAISE EXCEPTION 'Plan de reacomodación inválido';\n    END IF;\n\n    FOR x IN\n        SELECT value\n        FROM jsonb_array_elements(COALESCE(p_plan,'[]'::jsonb))\n        ORDER BY COALESCE((value->>'profundidad')::integer,0) DESC\n    LOOP\n        SELECT *\n        INTO r\n        FROM public.reservas\n        WHERE id = (x->>'reserva_id')::uuid\n        FOR UPDATE;\n\n        IF NOT FOUND THEN\n            RAISE EXCEPTION 'Reserva del plan no encontrada';\n        END IF;\n\n        IF r.estado = 'en_casa' THEN\n            RAISE EXCEPTION 'Una reserva en casa nunca puede ser movida';\n        END IF;\n\n        IF NOT EXISTS (\n            SELECT 1\n            FROM public.unidades u\n            WHERE u.id = (x->>'unidad_destino')::uuid\n              AND u.activo\n        ) THEN\n            RAISE EXCEPTION 'La unidad de destino no existe o está inactiva';\n        END IF;\n\n        -- Se vuelve a validar el conflicto justo antes del UPDATE.\n        IF EXISTS (\n            SELECT 1\n            FROM public.reservas z\n            WHERE z.id <> r.id\n              AND z.unidad_id = (x->>'unidad_destino')::uuid\n              AND z.fecha_entrada < r.fecha_salida\n              AND z.fecha_salida > r.fecha_entrada\n              AND z.estado IN ('tentativa','confirmada','en_casa','bloqueado')\n        ) THEN\n            RAISE EXCEPTION 'La reacomodación dejó de ser válida: destino ocupado';\n        END IF;\n\n        UPDATE public.reservas\n        SET unidad_id = (x->>'unidad_destino')::uuid\n        WHERE id = r.id;\n    END LOOP;\n\n    -- Última comprobación de la unidad solicitada.\n    IF EXISTS (\n        SELECT 1\n        FROM public.reservas z\n        WHERE z.unidad_id = p_unidad_id\n          AND z.fecha_entrada < p_fecha_salida\n          AND z.fecha_salida > p_fecha_entrada\n          AND z.estado IN ('tentativa','confirmada','en_casa','bloqueado')\n    ) THEN\n        RAISE EXCEPTION 'La unidad solicitada quedó ocupada; la operación fue revertida';\n    END IF;\n\n    INSERT INTO public.reservas (\n        huesped_id,\n        unidad_id,\n        fecha_entrada,\n        fecha_salida,\n        estado,\n        canal,\n        referencia_externa,\n        adultos,\n        menores,\n        tarifa_noche,\n        usa_estacionamiento,\n        noches_estacionamiento,\n        modelo_vehiculo,\n        patente_vehiculo\n    )\n    VALUES (\n        p_huesped_id,\n        p_unidad_id,\n        p_fecha_entrada,\n        p_fecha_salida,\n        p_estado,\n        p_canal,\n        NULLIF(trim(p_referencia_externa),''),\n        p_adultos,\n        p_menores,\n        p_tarifa_noche,\n        p_usa_estacionamiento,\n        CASE WHEN p_usa_estacionamiento THEN p_noches_estacionamiento ELSE 0 END,\n        p_modelo_vehiculo,\n        p_patente_vehiculo\n    )\n    RETURNING id INTO v_id;\n\n    RETURN v_id;\nEND;\n$function$\n",
