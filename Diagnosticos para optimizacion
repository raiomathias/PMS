			"definicion": "CREATE OR REPLACE FUNCTION public.buzon_puede_ver_audiencia(p_audiencia text)\n RETURNS boolean\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nDECLARE\n  v_rol text;\n  v_egana boolean;\n  v_huasco boolean;\nBEGIN\n  IF auth.uid() IS NULL THEN\n    RETURN false;\n  END IF;\n\n  SELECT lower(rol::text)\n    INTO v_rol\n  FROM public.perfiles\n  WHERE id = auth.uid()\n    AND activo = true;\n\n  IF v_rol IS NULL THEN\n    RETURN false;\n  END IF;\n\n  -- Sysadmin puede ver todas las audiencias.\n  IF v_rol IN ('sysadmin', 'system_admin', 'systemadmin') THEN\n    RETURN true;\n  END IF;\n\n  IF p_audiencia = 'recepcion_egana' THEN\n    SELECT COALESCE(recepcion_egana, false)\n      INTO v_egana\n    FROM public.perfiles_permisos_buzon\n    WHERE perfil_id = auth.uid();\n\n    RETURN COALESCE(v_egana, false);\n\n  ELSIF p_audiencia = 'recepcion_huasco' THEN\n    SELECT COALESCE(recepcion_huasco, false)\n      INTO v_huasco\n    FROM public.perfiles_permisos_buzon\n    WHERE perfil_id = auth.uid();\n\n    RETURN COALESCE(v_huasco, false);\n\n  ELSIF p_audiencia = 'administracion' THEN\n    RETURN v_rol IN ('administracion', 'gerencia');\n\n  ELSIF p_audiencia = 'gerencia' THEN\n    RETURN v_rol = 'gerencia';\n  END IF;\n\n  RETURN false;\nEND;\n$function$\n",
