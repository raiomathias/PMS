			"definicion": "CREATE OR REPLACE FUNCTION public.pms_resolver_liberacion(p_pend uuid[], p_mov jsonb, p_unidad_obj uuid, p_entrada date, p_salida date, p_excluir uuid, p_restantes integer, p_presupuesto integer)\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nDECLARE\n  v_x public.reservas%rowtype;\n  v_src_tipo uuid;\n  v_cand record;\n  v_evict uuid[];\n  v_malo boolean;\n  v_hijo jsonb;\n  v_gastado integer := 0;\nBEGIN\n  IF cardinality(p_pend) = 0 THEN\n    RETURN jsonb_build_object('mov', p_mov, 'gastado', 0);\n  END IF;\n  IF p_restantes <= 0 OR p_presupuesto <= 0 THEN\n    RETURN jsonb_build_object('mov', 'null'::jsonb, 'gastado', 1);\n  END IF;\n\n  SELECT r.* INTO v_x FROM public.reservas r WHERE r.id = p_pend[1];\n  IF NOT FOUND THEN\n    RETURN jsonb_build_object('mov', 'null'::jsonb, 'gastado', 1);\n  END IF;\n\n  SELECT u.tipo_unidad_id INTO v_src_tipo FROM public.unidades u WHERE u.id = v_x.unidad_id;\n\n  FOR v_cand IN\n    SELECT q.cid\n      FROM (\n        SELECT c.id AS cid, c.orden, c.codigo,\n               (SELECT count(*)\n                  FROM public.reservas y\n                 WHERE y.id <> v_x.id\n                   AND y.id IS DISTINCT FROM p_excluir\n                   AND y.estado IN ('tentativa','confirmada','en_casa','bloqueado')\n                   AND COALESCE((p_mov ->> (y.id::text))::uuid, y.unidad_id) = c.id\n                   AND y.fecha_entrada < v_x.fecha_salida\n                   AND y.fecha_salida > v_x.fecha_entrada) AS n_conf,\n               CASE WHEN c.tipo_unidad_id IS NOT DISTINCT FROM v_src_tipo THEN 0 ELSE 1 END AS cat\n          FROM public.unidades c\n         WHERE c.activo\n           AND c.id <> v_x.unidad_id\n           AND public.pms_destino_reacomodacion_permitido(v_x.unidad_id, c.id)\n      ) q\n     ORDER BY q.n_conf, q.cat, q.orden, q.codigo\n  LOOP\n    -- La reserva principal ocupará la unidad objetivo durante [entrada, salida).\n    IF v_cand.cid = p_unidad_obj\n       AND p_entrada < v_x.fecha_salida\n       AND p_salida > v_x.fecha_entrada THEN\n      CONTINUE;\n    END IF;\n\n    SELECT COALESCE(array_agg(y.id ORDER BY y.fecha_entrada, y.id)\n                    FILTER (WHERE NOT (y.id = ANY(p_pend))), ARRAY[]::uuid[]),\n           COALESCE(bool_or(\n             y.estado IN ('en_casa','bloqueado')\n             OR COALESCE(y.no_mover_unidad, false)\n             OR (p_mov ->> (y.id::text)) IS NOT NULL\n           ), false)\n      INTO v_evict, v_malo\n      FROM public.reservas y\n     WHERE y.id <> v_x.id\n       AND y.id IS DISTINCT FROM p_excluir\n       AND y.estado IN ('tentativa','confirmada','en_casa','bloqueado')\n       AND COALESCE((p_mov ->> (y.id::text))::uuid, y.unidad_id) = v_cand.cid\n       AND y.fecha_entrada < v_x.fecha_salida\n       AND y.fecha_salida > v_x.fecha_entrada;\n\n    IF v_malo THEN CONTINUE; END IF;\n\n    v_hijo := public.pms_resolver_liberacion(\n      p_pend[2:cardinality(p_pend)] || v_evict,\n      p_mov || jsonb_build_object(v_x.id::text, v_cand.cid),\n      p_unidad_obj, p_entrada, p_salida, p_excluir,\n      p_restantes - 1,\n      p_presupuesto - v_gastado - 1\n    );\n    v_gastado := v_gastado + 1 + COALESCE((v_hijo ->> 'gastado')::integer, 0);\n\n    IF jsonb_typeof(v_hijo -> 'mov') = 'object' THEN\n      RETURN jsonb_build_object('mov', v_hijo -> 'mov', 'gastado', v_gastado);\n    END IF;\n    IF v_gastado >= p_presupuesto THEN EXIT; END IF;\n  END LOOP;\n\n  RETURN jsonb_build_object('mov', 'null'::jsonb, 'gastado', GREATEST(v_gastado, 1));\nEND;\n$function$\n",
