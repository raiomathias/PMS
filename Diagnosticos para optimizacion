			"definicion": "CREATE OR REPLACE FUNCTION public.proteger_rol_perfil()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nbegin\r\n  if auth.uid() is not null and new.rol is distinct from old.rol then\r\n    if new.id = auth.uid() then\r\n      raise exception 'No puedes cambiar tu propio rol';\r\n    end if;\r\n    if not (new.rol = any(roles_gestionables()) and old.rol = any(roles_gestionables())) then\r\n      raise exception 'No tienes permiso para asignar ese rol';\r\n    end if;\r\n  end if;\r\n  return new;\r\nend $function$\n",
