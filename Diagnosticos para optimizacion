		{
			"nombre": "estadisticas_gerencia",
			"esquema": "public",
			"retorno": "jsonb",
			"lenguaje": "plpgsql",
			"argumentos": "p_desde date, p_hasta date, p_edificio_id uuid, p_unidad_id uuid",
			"definicion": "CREATE OR REPLACE FUNCTION public.estadisticas_gerencia(p_desde date DEFAULT (CURRENT_DATE - 29), p_hasta date DEFAULT CURRENT_DATE, p_edificio_id uuid DEFAULT NULL::uuid, p_unidad_id uuid DEFAULT NULL::uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\nDECLARE\n  v_user uuid := auth.uid();\n  v_rol text := public.rol_actual();\n  v_total_unidades integer;\n  v_reservas bigint;\n  v_noches bigint;\n  v_ingreso numeric;\n  v_pagado numeric;\n  v_pendiente numeric;\n  v_ocupacion numeric;\n  v_adr numeric;\n  v_revpar numeric;\n  v_los numeric;\n  v_lead numeric;\nBEGIN\n  IF v_user IS NULL THEN RAISE EXCEPTION 'Sesión no válida'; END IF;\n  IF v_rol NOT IN ('gerencia','sysadmin') THEN\n    RAISE EXCEPTION 'Solo Gerencia o SysAdmin puede acceder a las estadísticas';\n  END IF;\n  IF p_hasta < p_desde THEN RAISE EXCEPTION 'El rango de fechas no es válido'; END IF;\n\n  IF p_edificio_id IS NOT NULL\n     AND v_rol NOT IN ('gerencia','sysadmin')\n     AND NOT EXISTS (\n       SELECT 1 FROM perfiles_edificios pe\n       WHERE pe.perfil_id=v_user AND pe.edificio_id=p_edificio_id\n     )\n  THEN RAISE EXCEPTION 'Sin permiso para este edificio'; END IF;\n\n  IF p_unidad_id IS NOT NULL AND NOT EXISTS (\n    SELECT 1 FROM unidades u\n    WHERE u.id=p_unidad_id\n      AND (p_edificio_id IS NULL OR u.edificio_id=p_edificio_id)\n  ) THEN RAISE EXCEPTION 'Unidad no encontrada'; END IF;\n\n  SELECT count(*) INTO v_total_unidades\n  FROM unidades u\n  WHERE u.activo\n    AND (p_edificio_id IS NULL OR u.edificio_id=p_edificio_id)\n    AND (p_unidad_id IS NULL OR u.id=p_unidad_id);\n\n  WITH b AS (\n    SELECT r.*,\n           GREATEST(r.fecha_entrada,p_desde) AS o_ent,\n           LEAST(r.fecha_salida,p_hasta+1) AS o_sal\n    FROM reservas r\n    JOIN unidades u ON u.id=r.unidad_id\n    WHERE u.activo\n      AND r.fecha_entrada < p_hasta+1\n      AND r.fecha_salida > p_desde\n      AND r.estado NOT IN ('cancelada','no_show','bloqueado')\n      AND (p_edificio_id IS NULL OR u.edificio_id=p_edificio_id)\n      AND (p_unidad_id IS NULL OR r.unidad_id=p_unidad_id)\n  )\n  SELECT count(*),coalesce(sum(GREATEST(o_sal-o_ent,0)),0),\n         coalesce(sum(GREATEST(o_sal-o_ent,0)*tarifa_noche),0),\n         coalesce(avg(GREATEST(o_sal-o_ent,0)),0)\n  INTO v_reservas,v_noches,v_ingreso,v_los\n  FROM b;\n\n  SELECT coalesce(sum(p.monto_clp),0) INTO v_pagado\n  FROM pagos p JOIN reservas r ON r.id=p.reserva_id\n  JOIN unidades u ON u.id=r.unidad_id\n  WHERE p.pagado_en::date BETWEEN p_desde AND p_hasta\n    AND (p_edificio_id IS NULL OR u.edificio_id=p_edificio_id)\n    AND (p_unidad_id IS NULL OR u.id=p_unidad_id);\n\n  v_pendiente:=GREATEST(v_ingreso-v_pagado,0);\n  v_adr:=CASE WHEN v_noches>0 THEN v_ingreso/v_noches ELSE 0 END;\n  v_ocupacion:=CASE WHEN v_total_unidades>0 THEN\n    LEAST(100,(v_noches::numeric/(v_total_unidades*(p_hasta-p_desde+1)))*100)\n    ELSE 0 END;\n  v_revpar:=CASE WHEN v_total_unidades>0 THEN\n    v_ingreso/(v_total_unidades*(p_hasta-p_desde+1))\n    ELSE 0 END;\n  SELECT coalesce(avg(GREATEST(r.fecha_entrada-r.creado_en::date,0)),0)\n  INTO v_lead\n  FROM reservas r JOIN unidades u ON u.id=r.unidad_id\n  WHERE r.fecha_entrada BETWEEN p_desde AND p_hasta\n    AND r.estado NOT IN ('cancelada','no_show','bloqueado')\n    AND (p_edificio_id IS NULL OR u.edificio_id=p_edificio_id)\n    AND (p_unidad_id IS NULL OR u.id=p_unidad_id);\n\n  RETURN jsonb_build_object(\n    'meta', jsonb_build_object('desde',p_desde,'hasta',p_hasta,'dias',p_hasta-p_desde+1),\n    'summary', jsonb_build_object(\n      'reservas',v_reservas,'noches',v_noches,'unidades',v_total_unidades,\n      'ocupacion_pct',round(v_ocupacion,2),'ingreso_habitaciones',round(v_ingreso,0),\n      'pagado_en_periodo',round(v_pagado,0),'pendiente_estimado',round(v_pendiente,0),\n      'adr',round(v_adr,0),'revpar',round(v_revpar,0),\n      'los_promedio',round(v_los,2),'lead_time_promedio',round(v_lead,2)\n    ),\n    'by_building',(\n      SELECT coalesce(jsonb_agg(to_jsonb(x) ORDER BY x.ocupacion_pct DESC),'[]'::jsonb)\n      FROM (\n        SELECT e.id,e.nombre,count(DISTINCT r.id) reservas,\n          coalesce(sum(GREATEST(LEAST(r.fecha_salida,p_hasta+1)-GREATEST(r.fecha_entrada,p_desde),0)),0) noches,\n          coalesce(sum(GREATEST(LEAST(r.fecha_salida,p_hasta+1)-GREATEST(r.fecha_entrada,p_desde),0)*r.tarifa_noche),0) ingreso,\n          round(LEAST(100,\n            coalesce(sum(GREATEST(LEAST(r.fecha_salida,p_hasta+1)-GREATEST(r.fecha_entrada,p_desde),0))::numeric/\n            NULLIF(count(DISTINCT u.id)*(p_hasta-p_desde+1),0)*100,0)),2) ocupacion_pct\n        FROM edificios e JOIN unidades u ON u.edificio_id=e.id AND u.activo\n        LEFT JOIN reservas r ON r.unidad_id=u.id\n          AND r.fecha_entrada<p_hasta+1 AND r.fecha_salida>p_desde\n          AND r.estado NOT IN ('cancelada','no_show','bloqueado')\n        WHERE (p_edificio_id IS NULL OR e.id=p_edificio_id)\n          AND (p_unidad_id IS NULL OR u.id=p_unidad_id)\n        GROUP BY e.id,e.nombre\n      ) x\n    ),\n    'by_unit',(\n      SELECT coalesce(jsonb_agg(to_jsonb(x) ORDER BY x.ingreso DESC),'[]'::jsonb)\n      FROM (\n        SELECT u.id,u.codigo,e.nombre edificio,\n          count(r.id) FILTER (WHERE r.id IS NOT NULL) reservas,\n          coalesce(sum(GREATEST(LEAST(r.fecha_salida,p_hasta+1)-GREATEST(r.fecha_entrada,p_desde),0)),0) noches,\n          coalesce(sum(GREATEST(LEAST(r.fecha_salida,p_hasta+1)-GREATEST(r.fecha_entrada,p_desde),0)*r.tarifa_noche),0) ingreso,\n          round(LEAST(100,coalesce(sum(GREATEST(LEAST(r.fecha_salida,p_hasta+1)-GREATEST(r.fecha_entrada,p_desde),0))::numeric/\n            NULLIF(p_hasta-p_desde+1,0)*100,0)),2) ocupacion_pct,\n          round(coalesce(avg(r.tarifa_noche) FILTER (WHERE r.estado NOT IN ('cancelada','no_show','bloqueado')),0),0) tarifa_media\n        FROM unidades u JOIN edificios e ON e.id=u.edificio_id\n        LEFT JOIN reservas r ON r.unidad_id=u.id AND r.fecha_entrada<p_hasta+1 AND r.fecha_salida>p_desde\n        WHERE u.activo AND (p_edificio_id IS NULL OR u.edificio_id=p_edificio_id)\n          AND (p_unidad_id IS NULL OR u.id=p_unidad_id)\n        GROUP BY u.id,u.codigo,e.nombre\n      ) x\n    ),\n    'by_channel',(\n      SELECT coalesce(jsonb_agg(to_jsonb(x) ORDER BY x.reservas DESC),'[]'::jsonb)\n      FROM (\n        SELECT r.canal::text canal,count(*) reservas,\n          coalesce(sum(GREATEST(LEAST(r.fecha_salida,p_hasta+1)-GREATEST(r.fecha_entrada,p_desde),0)),0) noches,\n          coalesce(sum(GREATEST(LEAST(r.fecha_salida,p_hasta+1)-GREATEST(r.fecha_entrada,p_desde),0)*r.tarifa_noche),0) ingreso\n        FROM reservas r JOIN unidades u ON u.id=r.unidad_id\n        WHERE r.fecha_entrada<p_hasta+1 AND r.fecha_salida>p_desde\n          AND r.estado NOT IN ('cancelada','no_show','bloqueado')\n          AND (p_edificio_id IS NULL OR u.edificio_id=p_edificio_id)\n          AND (p_unidad_id IS NULL OR u.id=p_unidad_id)\n        GROUP BY r.canal\n      ) x\n    ),\n    'by_status',(\n      SELECT coalesce(jsonb_agg(to_jsonb(x) ORDER BY x.cantidad DESC),'[]'::jsonb)\n      FROM (\n        SELECT r.estado::text estado,count(*) cantidad\n        FROM reservas r JOIN unidades u ON u.id=r.unidad_id\n        WHERE r.fecha_entrada<p_hasta+1 AND r.fecha_salida>p_desde\n          AND (p_edificio_id IS NULL OR u.edificio_id=p_edificio_id)\n          AND (p_unidad_id IS NULL OR u.id=p_unidad_id)\n        GROUP BY r.estado\n      ) x\n    ),\n    'daily',(\n      SELECT coalesce(jsonb_agg(to_jsonb(x) ORDER BY x.fecha),'[]'::jsonb)\n      FROM (\n        SELECT d::date fecha,\n          count(r.id) FILTER (WHERE r.fecha_entrada=d::date) check_ins,\n          count(r.id) FILTER (WHERE r.fecha_salida=d::date) check_outs,\n          count(r.id) FILTER (WHERE r.fecha_entrada<d::date+1 AND r.fecha_salida>d::date\n             AND r.estado NOT IN ('cancelada','no_show','bloqueado')) reservas_activas,\n          coalesce(sum(r.tarifa_noche) FILTER (WHERE r.fecha_entrada=d::date\n             AND r.estado NOT IN ('cancelada','no_show','bloqueado')),0) ingresos_entradas\n        FROM generate_series(p_desde,p_hasta,'1 day') d\n        LEFT JOIN reservas r ON r.fecha_entrada<=d::date AND r.fecha_salida>d::date\n          AND r.estado NOT IN ('cancelada','no_show','bloqueado')\n        LEFT JOIN unidades u ON u.id=r.unidad_id\n        WHERE (p_edificio_id IS NULL OR u.edificio_id=p_edificio_id)\n          AND (p_unidad_id IS NULL OR u.id=p_unidad_id)\n        GROUP BY d\n      ) x\n    ),\n    'by_weekday',(\n      SELECT coalesce(jsonb_agg(to_jsonb(x) ORDER BY x.dia_num),'[]'::jsonb)\n      FROM (\n        SELECT extract(isodow from r.fecha_entrada)::int dia_num,\n          to_char(r.fecha_entrada,'TMDay') dia,\n          count(*) reservas,round(avg(r.noches),2) los_promedio,\n          round(avg(r.fecha_entrada-r.creado_en::date),2) lead_promedio\n        FROM reservas r JOIN unidades u ON u.id=r.unidad_id\n        WHERE r.fecha_entrada BETWEEN p_desde AND p_hasta\n          AND r.estado NOT IN ('cancelada','no_show','bloqueado')\n          AND (p_edificio_id IS NULL OR u.edificio_id=p_edificio_id)\n          AND (p_unidad_id IS NULL OR u.id=p_unidad_id)\n        GROUP BY 1,2\n      ) x\n    ),\n    'by_payment',(\n      SELECT coalesce(jsonb_agg(to_jsonb(x) ORDER BY x.monto DESC),'[]'::jsonb)\n      FROM (\n        SELECT p.metodo::text metodo,count(*) pagos,coalesce(sum(p.monto_clp),0) monto\n        FROM pagos p JOIN reservas r ON r.id=p.reserva_id JOIN unidades u ON u.id=r.unidad_id\n        WHERE p.pagado_en::date BETWEEN p_desde AND p_hasta\n          AND (p_edificio_id IS NULL OR u.edificio_id=p_edificio_id)\n          AND (p_unidad_id IS NULL OR u.id=p_unidad_id)\n        GROUP BY p.metodo\n      ) x\n    ),\n    'extras',(\n      SELECT coalesce(jsonb_agg(to_jsonb(x) ORDER BY x.monto DESC),'[]'::jsonb)\n      FROM (\n        SELECT coalesce(c.tipo::text,'otro') tipo,count(*) cantidad,coalesce(sum(c.total),0) monto\n        FROM cargos c JOIN reservas r ON r.id=c.reserva_id JOIN unidades u ON u.id=r.unidad_id\n        WHERE c.creado_en::date BETWEEN p_desde AND p_hasta\n          AND c.descripcion NOT IN ('__PMS_IVA__','__PMS_OTRO_PRECIO__','__PMS_AJUSTE_TOTAL_MANUAL__')\n          AND (p_edificio_id IS NULL OR u.edificio_id=p_edificio_id)\n          AND (p_unidad_id IS NULL OR u.id=p_unidad_id)\n        GROUP BY c.tipo\n      ) x\n    ),\n    'guest_profile',(\n      SELECT jsonb_build_object(\n        'huespedes_unicos',count(DISTINCT r.huesped_id),\n        'adultos',coalesce(sum(r.adultos),0),\n        'menores',coalesce(sum(r.menores),0),\n        'estacionamiento_reservas',count(*) FILTER (WHERE r.usa_estacionamiento),\n        'noches_estacionamiento',coalesce(sum(r.noches_estacionamiento),0),\n        'vip',count(*) FILTER (WHERE h.es_vip),\n        'acompanantes',coalesce((SELECT count(*) FROM acompanantes a JOIN reservas ar ON ar.id=a.reserva_id JOIN unidades au ON au.id=ar.unidad_id WHERE ar.fecha_entrada<p_hasta+1 AND ar.fecha_salida>p_desde AND ar.estado NOT IN ('cancelada','no_show','bloqueado') AND (p_edificio_id IS NULL OR au.edificio_id=p_edificio_id) AND (p_unidad_id IS NULL OR au.id=p_unidad_id)),0)\n      )\n      FROM reservas r JOIN unidades u ON u.id=r.unidad_id LEFT JOIN huespedes h ON h.id=r.huesped_id\n      WHERE r.fecha_entrada<p_hasta+1 AND r.fecha_salida>p_desde\n        AND r.estado NOT IN ('cancelada','no_show','bloqueado')\n        AND (p_edificio_id IS NULL OR u.edificio_id=p_edificio_id)\n        AND (p_unidad_id IS NULL OR u.id=p_unidad_id)\n    ),\n    'patterns',jsonb_build_object(\n      'peak_arrival_weekday',(\n        SELECT to_char(r.fecha_entrada,'TMDay') FROM reservas r JOIN unidades u ON u.id=r.unidad_id\n        WHERE r.fecha_entrada BETWEEN p_desde AND p_hasta AND r.estado NOT IN ('cancelada','no_show','bloqueado')\n          AND (p_edificio_id IS NULL OR u.edificio_id=p_edificio_id) AND (p_unidad_id IS NULL OR u.id=p_unidad_id)\n        GROUP BY to_char(r.fecha_entrada,'TMDay'),extract(isodow from r.fecha_entrada)\n        ORDER BY count(*) DESC LIMIT 1),\n      'peak_unit',(\n        SELECT u.codigo FROM reservas r JOIN unidades u ON u.id=r.unidad_id\n        WHERE r.fecha_entrada<p_hasta+1 AND r.fecha_salida>p_desde AND r.estado NOT IN ('cancelada','no_show','bloqueado')\n          AND (p_edificio_id IS NULL OR u.edificio_id=p_edificio_id) AND (p_unidad_id IS NULL OR u.id=p_unidad_id)\n        GROUP BY u.id,u.codigo ORDER BY sum(GREATEST(LEAST(r.fecha_salida,p_hasta+1)-GREATEST(r.fecha_entrada,p_desde),0)) DESC LIMIT 1),\n      'repeat_guests',(\n        SELECT count(*) FROM (\n          SELECT r.huesped_id FROM reservas r JOIN unidades u ON u.id=r.unidad_id\n          WHERE r.fecha_entrada<p_hasta+1 AND r.fecha_salida>p_desde AND r.estado NOT IN ('cancelada','no_show','bloqueado')\n            AND r.huesped_id IS NOT NULL AND (p_edificio_id IS NULL OR u.edificio_id=p_edificio_id) AND (p_unidad_id IS NULL OR u.id=p_unidad_id)\n          GROUP BY r.huesped_id HAVING count(*)>1\n        ) q),\n      'cancellation_rate',(\n        SELECT round(100.0*count(*) FILTER(WHERE r.estado='cancelada')/NULLIF(count(*),0),2)\n        FROM reservas r JOIN unidades u ON u.id=r.unidad_id\n        WHERE r.fecha_entrada BETWEEN p_desde AND p_hasta\n          AND (p_edificio_id IS NULL OR u.edificio_id=p_edificio_id) AND (p_unidad_id IS NULL OR u.id=p_unidad_id)\n      ),\n      'no_show_rate',(\n        SELECT round(100.0*count(*) FILTER(WHERE r.estado='no_show')/NULLIF(count(*),0),2)\n        FROM reservas r JOIN unidades u ON u.id=r.unidad_id\n        WHERE r.fecha_entrada BETWEEN p_desde AND p_hasta\n          AND (p_edificio_id IS NULL OR u.edificio_id=p_edificio_id) AND (p_unidad_id IS NULL OR u.id=p_unidad_id)\n      )\n    ),\n    'audit',(\n      SELECT jsonb_build_object('eventos',count(*),'usuarios_activos',count(DISTINCT a.usuario_id))\n      FROM auditoria a\n      WHERE a.fecha::date BETWEEN p_desde AND p_hasta\n    ),\n    'complaints',(\n      SELECT jsonb_build_object('total',count(*))\n      FROM reclamos_sugerencias rs JOIN reservas rr ON rr.id=rs.reserva_id JOIN unidades uu ON uu.id=rr.unidad_id\n      WHERE rs.creado_en::date BETWEEN p_desde AND p_hasta\n        AND (p_edificio_id IS NULL OR uu.edificio_id=p_edificio_id)\n        AND (p_unidad_id IS NULL OR uu.id=p_unidad_id)\n    )\n  );\nEND;\n$function$\n",
