			"definicion": "CREATE OR REPLACE FUNCTION public.registrar_auditoria()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\ndeclare\r\n  v_viejo jsonb;\r\n  v_nuevo jsonb;\r\nbegin\r\n  if tg_op in ('UPDATE','DELETE') then v_viejo := to_jsonb(old); end if;\r\n  if tg_op in ('INSERT','UPDATE') then v_nuevo := to_jsonb(new); end if;\r\n\r\n  insert into auditoria (tabla, registro_id, accion, datos_anteriores, datos_nuevos, usuario_id)\r\n  values (tg_table_name,\r\n          (coalesce(v_nuevo->>'id', v_viejo->>'id'))::uuid,\r\n          tg_op, v_viejo, v_nuevo, auth.uid());\r\n  return null;\r\nend $function$\n",
