			"definicion": "CREATE OR REPLACE FUNCTION public.auditoria_buscar(p_desde date DEFAULT NULL::date, p_hasta date DEFAULT NULL::date, p_usuario uuid DEFAULT NULL::uuid, p_sin_usuario boolean DEFAULT false, p_tablas text[] DEFAULT NULL::text[], p_acciones text[] DEFAULT NULL::text[], p_texto text DEFAULT NULL::text, p_monto_min numeric DEFAULT NULL::numeric, p_monto_max numeric DEFAULT NULL::numeric, p_campos text[] DEFAULT NULL::text[], p_limite integer DEFAULT 50, p_desplazamiento integer DEFAULT 0)\n RETURNS TABLE(id bigint, tabla text, registro_id uuid, accion text, datos_anteriores jsonb, datos_nuevos jsonb, usuario_id uuid, usuario_nombre text, usuario_rol text, fecha timestamp with time zone, reserva_id uuid, reserva_uid text, huesped text, monto numeric, total bigint)\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\nbegin\n  if coalesce(public.pms_rol(), '') not in ('gerencia','sysadmin') then\n    raise exception 'Solo Gerencia o SysAdmin pueden ver la auditoría';\n  end if;\n  return query\n    select f.*, count(*) over ()\n      from public._aud_filtrada(p_desde, p_hasta, p_usuario, p_sin_usuario, p_tablas, p_acciones,\n                                p_texto, p_monto_min, p_monto_max, p_campos) f\n     order by f.fecha desc, f.id desc\n     limit least(coalesce(p_limite, 50), 1000)\n    offset greatest(coalesce(p_desplazamiento, 0), 0);\nend $function$\n",
